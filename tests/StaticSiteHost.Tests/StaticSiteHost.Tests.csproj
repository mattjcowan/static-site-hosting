<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the host's pure pieces: parsers and rules that need no server, no disk and no
    network. The one exception is ProxyForwardingTests, which runs proxy routes against real servers
    on loopback, because forwarding is only worth testing over real connections.
    Run with: dotnet test tests/StaticSiteHost.Tests
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/StaticSiteHost/StaticSiteHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
