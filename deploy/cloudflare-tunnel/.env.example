# Copy to .env next to docker-compose.yml and fill in. Keep .env out of version control.

# The tunnel's token: Zero Trust → Networks → Tunnels → Create a tunnel → Cloudflared, then the
# token in the "install and run a connector" command (the long value after --token).
TUNNEL_TOKEN=

# Where the management UI answers. Give it a route in the tunnel too (see the README).
MANAGEMENT_HOST=admin.example.com

# The first administrator's password. Empty: one is generated and shown in the log.
ADMIN_PASSWORD=

# Optional: an API key that works from the first start, sshost_<id>_<secret>.
ADMIN_API_KEY=

# Optional: slim serves static sites only, without functions.
# IMAGE_TAG=latest
