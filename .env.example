# Copy to .env and adjust. docker compose reads it automatically.

# Which published image to run: latest includes the .NET SDK so uploaded functions can
# be compiled; slim is ~700 MB smaller and serves static sites only.
IMAGE_TAG=latest

# Only when building from source (docker compose up --build): runtime-functions matches
# latest, runtime matches slim.
IMAGE_TARGET=runtime-functions

# Host port the container is published on. Use 80 in production so hosted
# domains resolve without a port number.
HTTP_PORT=8080

# Host port for HTTPS, when the server ends HTTPS itself (TLS_ENABLED=true). Use 443, and
# HTTP_PORT=80: Let's Encrypt checks port 80 only.
HTTPS_PORT=8443

# HTTPS in the server, with a certificate from Let's Encrypt for every site and management host.
# Leave it false when a proxy in front (Caddy, nginx, Railway, a Cloudflare Tunnel) ends HTTPS.
TLS_ENABLED=false
# Optional: a contact address for the ACME account. (Let's Encrypt no longer sends expiry e-mails;
# the HTTPS page and the audit log show expiry and renewal instead.)
ACME_EMAIL=
# production, or staging to try it without Let's Encrypt's rate limits (browsers do not trust
# staging certificates), or the URL of another ACME server.
ACME_DIRECTORY=production

# Hostname the management UI answers on, e.g. deploy.example.com.
# Leave empty and the management UI answers on any host that has no site published.
MANAGEMENT_HOST=

# Only when a trusted reverse proxy terminates TLS in front of this container.
TRUST_FORWARDED_HEADERS=false

# First administrator. Leave the password empty to have one generated on first run
# (printed to the log and written to /data/config/bootstrap-password.txt).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator

# Forgot the administrator password? Set to true for one start: the password is reset
# to ADMIN_PASSWORD (or a newly generated one, printed to the log). Set back to false
# after signing in, or it is reset again on every restart.
ADMIN_RESET_PASSWORD_ON_STARTUP=false

# An API key for the administrator that works from the first start, so a script or an AI agent
# (over MCP at /mcp) can set the server up before anyone signs in. Make one with:
#   echo "sshost_$(openssl rand -hex 6)_$(openssl rand -hex 24)"
# Treat it like the password. Remove it to revoke the key.
ADMIN_API_KEY=

MAX_UPLOAD_BYTES=536870912
RELEASES_TO_KEEP=3
