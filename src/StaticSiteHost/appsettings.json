{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "AllowedHosts": "*",

  "SiteHosting": {
    "DataRoot": "/data",
    "ManagementHosts": [],
    "TrustForwardedHeaders": false,
    "MaxUploadBytes": 536870912,
    "MaxExtractedBytes": 2147483648,
    "MaxEntryBytes": 536870912,
    "MaxEntries": 50000,
    "ReleasesToKeep": 5,
    "AssetCacheSeconds": 3600,
    "SpaFallbackForAllRequests": false,
    "InviteLifetimeHours": 168,
    "MinPasswordLength": 12
  },

  "Bootstrap": {
    "Username": "admin",
    "Password": "",
    "DisplayName": "Administrator",
    "MustChangePassword": false,
    "ResetPasswordOnStartup": false
  }
}
