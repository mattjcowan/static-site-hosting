@page
@model LoginModel
@inject StaticSiteHost.Services.BrandingService Branding
@{
    ViewData["Title"] = L["auth.signIn.title"].Value;
    var brand = await Branding.ViewAsync(null, Brand.DefaultName);
}

<div class="narrow">
    <div class="page-head">
        <h1>@L["auth.signIn.title"]</h1>
        @* The owner's own words, set under Branding; not translated. *@
        @if (brand.SignInMessage is { } message)
        {
            <p class="sign-in-message">@message</p>
        }
        <p>@L["auth.signIn.intro"]</p>
    </div>

    <div class="card">
        <form method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error" role="alert">
                    @foreach (var message in ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Distinct())
                    {
                        <div>@message</div>
                    }
                </div>
            }

            <div class="field">
                <label asp-for="Input.Username">@L["auth.signIn.username"]</label>
                <input asp-for="Input.Username" autocomplete="username" autofocus required />
            </div>

            <div class="field">
                <label asp-for="Input.Password">@L["auth.signIn.password"]</label>
                <input asp-for="Input.Password" type="password" autocomplete="current-password" required />
            </div>

            <button type="submit" class="btn-primary" style="width:100%">@L["auth.signIn.submit"]</button>
        </form>
    </div>
</div>
