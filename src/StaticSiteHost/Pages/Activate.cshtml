@page
@model ActivateModel
@{
    ViewData["Title"] = L["auth.activate.title"].Value;
}

<div class="narrow">
    @if (!Model.TokenIsValid)
    {
        <div class="page-head">
            <h1>@L["auth.activate.invalid.title"]</h1>
            <p>@L["auth.activate.invalid.intro"]</p>
        </div>
        <div class="card">
            <p class="hint">@L["auth.activate.invalid.hint"]</p>
            <a class="btn" asp-page="/Login">@L["auth.activate.invalid.signIn"]</a>
        </div>
    }
    else
    {
        <div class="page-head">
            <h1>@L["auth.activate.title"]</h1>
            <p>@L.Html("auth.activate.intro", new { username = Model.Username })</p>
        </div>

        <div class="card">
            <form method="post">
                <input type="hidden" asp-for="Token" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-error" role="alert">
                        @foreach (var message in ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Distinct())
                        {
                            <div>@message</div>
                        }
                    </div>
                }

                <div class="field">
                    <label asp-for="Input.Password">@L["auth.activate.password"]</label>
                    <input asp-for="Input.Password" type="password" autocomplete="new-password" autofocus required />
                </div>

                <div class="field">
                    <label asp-for="Input.ConfirmPassword">@L["auth.activate.confirm"]</label>
                    <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
                </div>

                <button type="submit" class="btn-primary" style="width:100%">@L["auth.activate.submit"]</button>
            </form>
        </div>
    }
</div>
