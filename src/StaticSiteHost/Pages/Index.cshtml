@page
@model IndexModel
@{
    ViewData["Title"] = L["deploy.pageTitle"].Value;
}

<div class="page-head">
    <h1>@L["deploy.title"]</h1>
    <p>@L["deploy.intro"]</p>
</div>

<div class="card">
    <form id="deploy-form" method="post" asp-page-handler="Deploy" enctype="multipart/form-data">
        <div class="field">
            <label for="domain">@L["deploy.domain.label"]</label>
            <div class="row">
                @if (Model.Sites.Count > 0)
                {
                    <div class="field" style="flex: 0 1 260px;">
                        <select id="domain-select" aria-label="@L["deploy.domain.existing"]">
                            <option value="">@L["deploy.domain.new"]</option>
                            @foreach (var site in Model.Sites)
                            {
                                <option value="@site.Domain">@site.Domain</option>
                            }
                        </select>
                    </div>
                }
                <div class="field">
                    <input type="text" id="domain" name="domain" placeholder="www.example.com"
                           autocomplete="off" autocapitalize="off" spellcheck="false" required />
                </div>
            </div>
            <p class="hint" style="margin-bottom:0">@L["deploy.domain.hint"]</p>
        </div>

        <div class="field">
            <label for="archive">@L["deploy.archive.label"]</label>
            <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="@L["deploy.archive.choose"]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12" />
                </svg>
                <strong id="file-label">@L["deploy.archive.drop"]</strong>
                <span id="file-hint">@L["deploy.archive.dropHint"]</span>
                <input type="file" id="archive" name="archive" accept=".zip,application/zip,application/x-zip-compressed" />
            </div>
            <p class="hint" style="margin-bottom:0">@L.Text("deploy.archive.hint", new { size = Model.MaxUploadDisplay })</p>
        </div>

        <progress id="deploy-progress" max="100" value="0" hidden></progress>

        <div id="deploy-result"></div>

        <button type="submit" id="deploy-button" class="btn-primary">@L["deploy.submit"]</button>
    </form>
</div>

<div class="card">
    <h2>@L["deploy.resolve.title"]</h2>
    <p class="hint">@L["deploy.resolve.hint"]</p>
    <table>
        <tbody>
            <tr>
                <td class="mono nowrap">/abc/def/</td>
                <td class="muted">@L.Html("deploy.resolve.folder", new { file = "/abc/def/index.html" })</td>
            </tr>
            <tr>
                <td class="mono nowrap">/abc/def/gemini</td>
                <td class="muted">@L.Html("deploy.resolve.page", new { htmlFile = "/abc/def/gemini.html", folderIndex = "/abc/def/index.html", rootIndex = "/index.html" })</td>
            </tr>
            <tr>
                <td class="mono nowrap">/assets/app.js</td>
                <td class="muted">@L.Html("deploy.resolve.asset")</td>
            </tr>
            <tr>
                <td class="mono nowrap">/404.html</td>
                <td class="muted">@L["deploy.resolve.notFound"]</td>
            </tr>
        </tbody>
    </table>
</div>
