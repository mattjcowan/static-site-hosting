@page
@model StaticSiteHost.Pages.Admin.ProxyModel
@using StaticSiteHost.Models
@{
    ViewData["Title"] = "Proxy";
}

<div class="page-head">
    <h1>Server-wide proxy routes</h1>
    <p>One route for many sites: every site whose domain matches the route's Sites gets it, without setting it on each one.</p>
</div>

<div class="card" id="proxy">
    <h2>
        Routes
        @if (Model.Editors.Count(e => !e.IsNew) > 0)
        {
            <span class="badge badge-ok">@Model.Editors.Count(e => !e.IsNew) route@(Model.Editors.Count(e => !e.IsNew) == 1 ? "" : "s")</span>
        }
        else
        {
            <span class="badge">none</span>
        }
    </h2>
    <p class="hint">
        A route here works like a site's own proxy route on every site it names, such as <span class="mono">/api</span> on <span class="mono">*.apps.example.com</span> forwarded to one
        API. A site's own route at the same path wins, so one site can point at a staging API, and a site can turn a server-wide route
        off on its own page. When two server-wide routes share a path, the one whose Sites names the site most closely wins: a domain
        over <span class="mono">*.something</span>, and both over <span class="mono">*</span>.
    </p>

    @foreach (var editor in Model.Editors.Where(e => !e.IsNew))
    {
        var route = (ServerProxyRoute)editor.Route;
        var reach = Model.Reach.GetValueOrDefault(editor.OriginalPath!) ?? [];
        <details class="proxy-route" open="@(editor.Errors.Count > 0 || editor.TestResult is not null)">
            <summary>
                <span class="mono">@route.Path</span>
                <span class="muted">→</span>
                <span class="mono proxy-target">@route.Target</span>
                <span class="badge">@route.Sites</span>
                @if (!route.Enabled)
                {
                    <span class="badge badge-warn">off</span>
                }
                @if (route.WebSockets)
                {
                    <span class="badge">WebSockets</span>
                }
                @if (route.Streaming)
                {
                    <span class="badge">streaming</span>
                }
                @if (route.GrpcWeb)
                {
                    <span class="badge">gRPC-Web</span>
                }
            </summary>
            <p class="hint proxy-reach">
                @if (reach.Count == 0)
                {
                    <text>No site on this server matches it yet.</text>
                }
                else
                {
                    <text>Sites it matches: </text>
                    @for (var i = 0; i < reach.Count; i++)
                    {
                        var (domain, state) = reach[i];
                        <a asp-page="/Sites/Details" asp-route-domain="@domain" asp-fragment="proxy" class="mono">@domain</a>
                        <span class="muted">(@state)</span>@(i < reach.Count - 1 ? ", " : "")
                    }
                }
            </p>
            <partial name="/Pages/Sites/_ProxyRoute.cshtml" model="editor" />
        </details>
    }

    @{ var adding = Model.Editors.Single(e => e.IsNew); }
    <details class="proxy-route proxy-add" open="@(Model.Editors.Count == 1 || adding.Errors.Count > 0)">
        <summary>Add a server-wide route</summary>
        <partial name="/Pages/Sites/_ProxyRoute.cshtml" model="adding" />
    </details>
</div>
