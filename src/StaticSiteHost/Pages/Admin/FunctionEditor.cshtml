@page "/admin/function-editor/{domain?}"
@model StaticSiteHost.Pages.Admin.FunctionEditorModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = Model.Domain is null ? L["editor.pageTitle.global"].Value : L.Text("editor.pageTitle.site", new { domain = Model.Domain });

    // What Deploy does differs by scope, and by whether something is live to be replaced.
    var deployHint = (Model.Domain is null, Model.Live is null) switch
    {
        (true, true) => "editor.hint.deployGlobal",
        (true, false) => "editor.hint.deployGlobalReplacing",
        (false, true) => "editor.hint.deploySite",
        (false, false) => "editor.hint.deploySiteReplacing",
    };
}

@* Its editor lives in scripts bound at load, so the assistant must not swap this page's content in place. *@
<div class="page-head" data-no-swap>
    <h1>@L["editor.title"]</h1>
    @if (Model.Domain is null)
    {
        <p>@L.Html("editor.intro.global", new { backUrl = Url.Page("/Admin/Functions") })</p>
    }
    else
    {
        <p>@L.Html("editor.intro.site", new { domain = Model.Domain, backUrl = Url.Page("/Sites/Details", null, new { domain = Model.Domain, tab = "app" }, null, null, "functions") })</p>
    }
</div>

<input type="hidden" id="fe-csrf" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
<script id="fe-data" type="application/json">@Html.Raw(Model.BootstrapJson)</script>

<div class="card">
    <div class="fe-tabs" id="fe-tabs" role="tablist" aria-label="@L["editor.files"]"></div>
    <div class="fe-editor" id="fe-editor"></div>

    <div class="fe-toolbar">
        <button type="button" id="fe-check">@L["editor.check"]</button>
        <button type="button" id="fe-deploy" class="btn-primary">@L["editor.deploy"]</button>
        <span id="fe-status" class="muted" role="status"></span>
    </div>
    <p class="hint">
        @L.Html("editor.hint.check")
        @L.Html(deployHint, new { label = Model.Live is { } live ? StaticSiteHost.Pages.Shared.FunctionUploads.Label(live, L) : null })
    </p>
    <div id="fe-problems"></div>
</div>

<div class="card">
    <h2>@L["editor.test.title"]</h2>
    <p class="hint">@L.Html("editor.test.hint")</p>

    <div class="row">
        <div class="field">
            <label for="fe-target">@L["editor.test.build"]</label>
            <select id="fe-target">
                <option value="" disabled>@L["editor.test.checkedBuild"]</option>
                <option value="live">@L["editor.test.liveBuild"]</option>
            </select>
        </div>
        <div class="field">
            <label for="fe-route">@L["editor.test.route"]</label>
            <select id="fe-route"></select>
        </div>
    </div>

    <div class="row">
        <div class="field fe-method">
            <label for="fe-method">@L["editor.test.method"]</label>
            <select id="fe-method">
                <option>GET</option><option>POST</option><option>PUT</option>
                <option>PATCH</option><option>DELETE</option><option>HEAD</option><option>OPTIONS</option>
            </select>
        </div>
        <div class="field">
            <label for="fe-path">@L["editor.test.path"]</label>
            <input id="fe-path" type="text" spellcheck="false" autocomplete="off" value="/" />
        </div>
        <div class="field">
            <label for="fe-query">@L["editor.test.query"]</label>
            <input id="fe-query" type="text" spellcheck="false" autocomplete="off" placeholder="page=2&amp;sort=name" />
        </div>
        @if (Model.Domain is null)
        {
            <div class="field">
                <label for="fe-host">@L["editor.test.domain"]</label>
                <input id="fe-host" type="text" spellcheck="false" autocomplete="off" placeholder="demo.example.com" />
            </div>
        }
    </div>
    <div id="fe-params" class="row"></div>

    <div class="grid-2">
        <div class="field">
            <label for="fe-headers">@L["editor.test.headers"]</label>
            <textarea id="fe-headers" rows="4" wrap="off" spellcheck="false" placeholder="Content-Type: application/json"></textarea>
        </div>
        <div class="field">
            <label for="fe-body">@L["editor.test.body"]</label>
            <textarea id="fe-body" rows="4" wrap="off" spellcheck="false" placeholder='{ "name": "Jane" }'></textarea>
        </div>
    </div>

    <button type="button" id="fe-run" class="btn-primary">@L["editor.test.run"]</button>
    <div id="fe-result" class="fe-result"></div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs/loader.js"></script>
    <script src="~/js/function-editor.js" asp-append-version="true"></script>
}
