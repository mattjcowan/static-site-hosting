@page
@model StaticSiteHost.Pages.Admin.HttpsModel
@using StaticSiteHost.Models
@{
    ViewData["Title"] = L["https.pageTitle"].Value;
}

<div class="page-head">
    <h1>@L["https.title"]</h1>
    <p>@L["https.intro"]</p>
</div>

@if (!Model.Enabled)
{
    <div class="card">
        <h2>@L["https.off.title"] <span class="badge">@L["https.off.badge"]</span></h2>
        <p class="hint">@L["https.off.hint"]</p>
        <pre class="tls-config">SiteHosting__Tls__Enabled=true
SiteHosting__Tls__AcmeEmail=you@example.com   # optional
# publish the container's 8080 as 80 and 8443 as 443</pre>
        <p class="hint" style="margin: 0.75rem 0 0">@L["https.off.after"]</p>
    </div>
}
else
{
    <div class="card">
        <h2>
            @L["https.server.title"]
            <span class="badge badge-ok">@L["common.on"]</span>
            @if (Model.Tls.IsStaging)
            {
                <span class="badge badge-warn">@L["https.server.staging"]</span>
            }
        </h2>
        <dl class="tls-facts">
            <dt>@L["https.server.listening"]</dt>
            <dd>@L.Text("https.server.listeningValue", new { httpPort = Model.Tls.HttpPort, httpsPort = Model.Tls.HttpsPort })</dd>
            <dt>@L["https.server.from"]</dt>
            <dd>@if (Model.Tls.AcmeEmail is { Length: > 0 } email)
                {
                    @L.Html("https.server.fromWithContact", new { url = Model.Tls.AcmeDirectoryUrl, email })
                }
                else
                {
                    <span class="mono">@Model.Tls.AcmeDirectoryUrl</span>
                }</dd>
            <dt>@L["https.server.automatic"]</dt>
            <dd>@L.Html("https.server.automaticValue", new { source = CertificateSourceNames.Of(L, Model.Tls.DefaultSource) })</dd>
            <dt>@L["https.server.renewed"]</dt>
            <dd>@L.Plural("https.server.renewedValue", Model.Tls.RenewDaysBefore)</dd>
        </dl>
        @if (Model.Tls.IsStaging)
        {
            <p class="hint">@L.Html("https.server.stagingHint")</p>
        }
    </div>

    <div class="card">
        <h2>@L["https.hosts.title"] <span class="badge">@Model.Hosts.Count</span></h2>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>@L["https.hosts.host"]</th><th>@L["https.hosts.certificate"]</th><th>@L["https.hosts.status"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var host in Model.Hosts)
                    {
                        <tr>
                            <td>
                                @if (host.IsSite)
                                {
                                    <a asp-page="/Sites/Details" asp-route-domain="@host.Host" asp-route-tab="security" asp-fragment="https" class="mono">@host.Host</a>
                                }
                                else
                                {
                                    <span class="mono">@host.Host</span> <span class="badge">@L["https.hosts.management"]</span>
                                }
                                <div class="cell-sub">@CertificateSourceNames.Of(L, host.Wanted)@(host.Wanted != host.Effective ? " → " + CertificateSourceNames.Of(L, host.Effective) : "")@(host.Effective == CertificateSources.LetsEncrypt && host.State.Check == "dns-01" ? " · " + L["https.hosts.checkedDns"].Value : "")</div>
                            </td>
                            <td>
                                @if (host.Served is { } served)
                                {
                                    var expires = served.NotAfter.ToLocalTime().ToString("yyyy-MM-dd");
                                    var daysLeft = HttpsModel.DaysLeft(served.NotAfter);
                                    <span>@served.Issuer</span>
                                    @if (served.SelfSigned)
                                    {
                                        <span class="badge badge-warn">@L["https.hosts.selfSigned"]</span>
                                    }
                                    <div class="cell-sub">@(daysLeft < 0 ? L.Text("https.hosts.expired", new { date = expires }) : L.Plural("https.hosts.expiresIn", daysLeft, new { date = expires }))@(host.RenewsAt is { } renews ? " " + L.Text("https.hosts.renewalStarts", new { date = renews.ToLocalTime().ToString("yyyy-MM-dd") }) : "")</div>
                                }
                                else
                                {
                                    <span class="muted">@(host.Effective == CertificateSources.None ? L["https.hosts.noneHttpOnly"] : L["https.hosts.noneYet"])</span>
                                }
                            </td>
                            <td>
                                @if (host.Busy)
                                {
                                    <span class="badge">@L["https.hosts.getting"]</span>
                                }
                                else if (host.Problem is { } problem)
                                {
                                    <span class="validation">@problem</span>
                                }
                                else if (host.Served is not null && host.ServedSource == host.Effective)
                                {
                                    <span class="badge badge-ok">@L["https.hosts.serving"]</span>
                                    @* Still serving, but the renewal failed: shown, so it is not found out at expiry. *@
                                    @if (host.State.LastError is { } renewalError)
                                    {
                                        <div class="cell-sub validation">@L.Text("https.hosts.renewalFailed", new { error = renewalError })</div>
                                        @if (host.State.NextAttemptUtc is { } retry)
                                        {
                                            <div class="cell-sub">@L.Text("https.hosts.retryAfter", new { time = retry.ToLocalTime().ToString("yyyy-MM-dd HH:mm") })</div>
                                        }
                                    }
                                }
                                else if (host.State.LastError is { } error)
                                {
                                    <span class="validation">@error</span>
                                    @if (host.State.NextAttemptUtc is { } next)
                                    {
                                        <div class="cell-sub">@L.Text("https.hosts.retryAfter", new { time = next.ToLocalTime().ToString("yyyy-MM-dd HH:mm") })</div>
                                    }
                                }
                                else if (host.Served is not null)
                                {
                                    <span class="badge badge-ok">@L["https.hosts.serving"]</span>
                                }
                            </td>
                            <td class="actions">
                                @if (host.Effective is CertificateSources.LetsEncrypt or CertificateSources.SelfSigned or CertificateSources.CloudflareOrigin && host.Problem is null)
                                {
                                    <form method="post" asp-page-handler="Renew">
                                        <input type="hidden" name="host" value="@host.Host" />
                                        <button type="submit" class="btn-link">@L["https.hosts.renew"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card">
    <h2>@L["https.shared.title"] <span class="badge">@Model.Shared.Count</span></h2>
    <p class="hint">@L.Html("https.shared.hint")</p>

    @if (Model.Shared.Count > 0)
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>@L["https.shared.names"]</th><th>@L["https.shared.issuer"]</th><th>@L["https.shared.expires"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var (info, certificate, busy) in Model.Shared)
                    {
                        <tr>
                            <td class="mono">@string.Join(", ", info.Names)</td>
                            <td>
                                @(certificate is null ? "—" : info.Issuer)
                                <div class="cell-sub">@(info.Source == CertificateSources.Uploaded
                                    ? L.Text("https.shared.uploadedBy", new { user = info.UploadedBy ?? "—" })
                                    : L.Text("https.shared.gotBy", new { source = CertificateSourceNames.Of(L, info.Source), user = info.UploadedBy ?? "—" }))</div>
                                @if (busy)
                                {
                                    <span class="badge">@L["https.hosts.getting"]</span>
                                }
                                else if (info.State.LastError is { } sharedError)
                                {
                                    <div class="cell-sub validation">@sharedError</div>
                                    @if (info.State.NextAttemptUtc is { } retry)
                                    {
                                        <div class="cell-sub">@L.Text("https.hosts.retryAfter", new { time = retry.ToLocalTime().ToString("yyyy-MM-dd HH:mm") })</div>
                                    }
                                }
                                else if (certificate is null)
                                {
                                    <div class="cell-sub">@L["https.shared.waiting"]</div>
                                }
                            </td>
                            <td class="nowrap">
                                @if (certificate is not null)
                                {
                                    var left = HttpsModel.DaysLeft(info.NotAfterUtc);
                                    @info.NotAfterUtc.ToLocalTime().ToString("yyyy-MM-dd")<div class="cell-sub">@(left < 0 ? L["https.shared.expired"].Value : L.Plural("https.shared.inDays", left))</div>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td class="actions">
                                @if (info.Source != CertificateSources.Uploaded && Model.Enabled)
                                {
                                    <form method="post" asp-page-handler="RenewShared">
                                        <input type="hidden" name="id" value="@info.Id" />
                                        <button type="submit" class="btn-link">@L["https.hosts.renew"]</button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="RemoveShared" data-confirm="@L.Text("https.shared.removeConfirm", new { names = string.Join(", ", info.Names) })">
                                    <input type="hidden" name="id" value="@info.Id" />
                                    <button type="submit" class="btn-link">@L["common.remove"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.Enabled)
    {
        <details class="tls-upload" open="@(Model.RequestError is not null)">
            <summary>@L["https.request.title"]</summary>
            @if (!Model.CloudflareConnected)
            {
                <p class="hint">@L.Html("https.request.needsCloudflare", new { dnsUrl = Url.Page("/Admin/Dns") })</p>
            }
            else
            {
                <p class="hint">@L.Html("https.request.hint")</p>
                @if (Model.RequestError is { } requestError)
                {
                    <div class="alert alert-error">@requestError</div>
                }
                <form method="post" asp-page-handler="RequestShared" class="row">
                    <div class="field" style="flex: 1 1 18rem">
                        <label for="request-names">@L["https.request.names"]</label>
                        <input type="text" id="request-names" name="names" value="@Model.RequestNames" placeholder="*.apps.example.com" spellcheck="false" autocomplete="off" required />
                    </div>
                    <div class="field">
                        <label for="request-source">@L["https.request.source"]</label>
                        <select id="request-source" name="source">
                            <option value="letsencrypt" selected="@(Model.RequestSource != CertificateSources.CloudflareOrigin)">@L["https.request.letsEncrypt"]</option>
                            <option value="cloudflare-origin" selected="@(Model.RequestSource == CertificateSources.CloudflareOrigin)">@L["https.request.cloudflareOrigin"]</option>
                        </select>
                    </div>
                    <button type="submit" class="btn-primary">@L["https.request.submit"]</button>
                </form>
            }
        </details>
    }

    <details class="tls-upload" open="@(Model.UploadError is not null)">
        <summary>@L["https.shared.upload"]</summary>
        @if (Model.UploadError is { } uploadError)
        {
            <div class="alert alert-error">@uploadError</div>
        }
        <form method="post" asp-page-handler="AddShared">
            <div class="field">
                <label for="shared-certificate">@L["https.shared.certificate"]</label>
                <textarea id="shared-certificate" name="certificate" class="rules" rows="5" wrap="off" spellcheck="false"
                          placeholder="-----BEGIN CERTIFICATE-----"></textarea>
            </div>
            <div class="field">
                <label for="shared-key">@L["https.shared.privateKey"]</label>
                <textarea id="shared-key" name="privateKey" class="rules" rows="5" wrap="off" spellcheck="false" autocomplete="off"
                          placeholder="-----BEGIN PRIVATE KEY-----"></textarea>
            </div>
            <button type="submit" class="btn-primary">@L["https.shared.submit"]</button>
        </form>
    </details>
</div>
