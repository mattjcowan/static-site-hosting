@page "{domain}/{tab?}"
@model StaticSiteHost.Pages.Sites.DetailsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = Model.Site.Domain;
    var url = SiteLinks.For(Request, Model.Site.Domain);
}

<div class="page-head">
    <h1>@Model.Site.Domain</h1>
    <p><a href="@url" target="_blank" rel="noopener">@url</a></p>
</div>

<nav class="tabs" aria-label="@L["site.tabs.label"]">
    @foreach (var (id, labelKey) in SiteTabs.For(Model.IsAdministrator))
    {
        <a href="@Url.Page("/Sites/Details", new { domain = Model.Site.Domain, tab = id == SiteTabs.Default ? null : id })" data-tab="@id"
           aria-current="@(Model.Tab == id ? "page" : null)">
            @L[labelKey]
            @if (Model.TabCount(id) is > 0 and var count)
            {
                <span class="count">@count</span>
            }
        </a>
    }
</nav>

<section class="tab-panel" data-tab="overview" hidden="@(Model.Tab != "overview")">
<details class="card section" data-section="release" open="@Sections.IsOpen(HttpContext, "release")">
    <summary class="section-head"><h2>@L["site.release.title"]</h2></summary>
    @if (Model.Site.Current is { IsFunctionsOnly: true } carrier)
    {
        <p class="hint">
            @L.Html("site.release.functionsOnly", new { id = carrier.Id, date = carrier.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm"), proxyUrl = "#proxy" })
        </p>
    }
    else if (Model.Site.Current is { } current)
    {
        <p class="hint">
            @L.PluralHtml("site.release.summary", current.FileCount, new
            {
                id = current.Id,
                files = current.FileCount.ToString("N0"),
                size = Format.Bytes(current.TotalBytes),
                date = current.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm"),
                name = current.DeployedBy ?? L.Text("site.release.unknownPerson"),
                source = current.Source switch
                {
                    "web" => L.Text("site.release.source.web"),
                    "api" => L.Text("site.release.source.api"),
                    "mcp" or "tools" => L.Text("site.release.source.tools"),
                    ReleaseRecord.CopySource => L.Text("site.release.source.copy", new { id = current.CopiedFrom }),
                    _ => current.Source
                }
            })
            @if (current.EditedUtc is { } edited)
            {
                @L.Text("site.release.edited", new { date = edited.ToLocalTime().ToString("yyyy-MM-dd HH:mm"), name = current.EditedBy ?? L.Text("site.release.unknownPerson") })
            }
        </p>
        @if (!current.HasRootIndex)
        {
            <div class="alert alert-warning">@L.Html("site.release.noRootIndex")</div>
        }
        @if (current.StrippedRootFolder)
        {
            <p class="hint">@L["site.release.unwrapped"]</p>
        }
    }
    else if (Model.Site.Proxy.Count > 0)
    {
        <p class="hint">
            @L.Html("site.release.proxyOnly", new { proxyUrl = "#proxy" })
        </p>
    }
    else
    {
        <div class="alert alert-warning">@L["site.release.none"]</div>
    }
    <a class="btn" asp-page="/Index">@L["site.release.deploy"]</a>
</details>

<details class="card section" data-section="deploy-cli" open="@Sections.IsOpen(HttpContext, "deploy-cli")">
    <summary class="section-head"><h2>@L["site.cli.title"]</h2></summary>
    <p class="hint">
        @L.Html("site.cli.hint", new { domain = Model.Site.Domain })
    </p>

    @if (Model.HasUsableApiKey)
    {
        <p class="hint">
            @L.Html("site.cli.keyHint")
        </p>
    }
    else
    {
        <div class="alert alert-warning">
            @L.Html("site.cli.noKey", new { accountUrl = Url.Page("/Account/Index") })
        </div>
    }

    @foreach (var snippet in Model.DeploySnippets)
    {
        <div class="snippet">
            <div class="snippet-head">
                <label for="@snippet.Id">@L[snippet.TitleKey]</label>
                <button type="button" class="btn btn-sm" data-copy="#@snippet.Id">@L["common.copy"]</button>
            </div>
            <textarea id="@snippet.Id" rows="@snippet.Lines" wrap="off" readonly spellcheck="false"
                      onclick="this.select()">@snippet.Command</textarea>
            <p class="hint snippet-hint">@L.Html(snippet.HintKey)</p>
        </div>
    }
</details>
</section>

<section class="tab-panel" data-tab="files" hidden="@(Model.Tab != "files")">
@{
    var filesSetup = System.Text.Json.JsonSerializer.Serialize(new
    {
        api = $"/ui/sites/{Uri.EscapeDataString(Model.Site.Domain)}/files",
        domain = Model.Site.Domain,
        siteUrl = url,
        maxEditBytes = DetailsModel.MaxEditBytes,
        icons = Icons.Markup("file", "folder", "image", "chevron-right", "save", "undo", "compare", "rename", "trash", "download", "upload", "file-plus", "external")
    });
}
<div class="card files" data-files data-csrf="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken">
    <script type="application/json" data-files-setup>@Html.Raw(filesSetup)</script>
    <div class="files-bar">
        <div class="files-release">
            <label for="files-release">@L["site.files.releaseLabel"]</label>
            <select id="files-release" data-files-release></select>
        </div>
        <div class="files-actions">
            <button type="button" class="btn btn-sm" data-files-duplicate disabled title="@L["site.files.duplicateTitle"]">@L["site.files.duplicate"]</button>
            <button type="button" class="btn-primary btn-sm" data-files-make-live hidden>@L["site.files.makeLive"]</button>
        </div>
        <p class="files-note" data-files-note role="status">@L["site.files.loading"]</p>
    </div>
    <div class="files-body">
        <div class="files-side">
            <div class="files-tools">
                <input type="search" data-files-filter placeholder="@L["site.files.filter"]" aria-label="@L["site.files.filter"]" spellcheck="false" autocomplete="off" />
                <button type="button" class="btn btn-sm btn-icon" data-files-new title="@L["site.files.newFile"]" aria-label="@L["site.files.newFile"]">@Icons.Get("file-plus")</button>
                <button type="button" class="btn btn-sm btn-icon" data-files-upload title="@L["site.files.upload"]" aria-label="@L["site.files.upload"]">@Icons.Get("upload")</button>
                <input type="file" multiple hidden data-files-upload-input />
            </div>
            <ul class="files-tree" role="tree" aria-label="@L["site.files.treeLabel"]" data-files-tree></ul>
        </div>
        <div class="files-main" data-files-main>
            <div class="files-head" data-files-head hidden></div>
            <div class="files-view" data-files-view>
                <p class="files-empty">@L["site.files.choose"]</p>
            </div>
        </div>
    </div>
    <p class="hint">@L.PluralHtml("site.files.hint", Model.ReleasesToKeep)</p>
    <p class="hint">
        @if (Model.IsAdministrator)
        {
            @L.Html("site.files.functionsAdmin", new { editorUrl = Url.Page("/Admin/FunctionEditor", new { domain = Model.Site.Domain }) })
        }
        else
        {
            @L.Html("site.files.functions")
        }
    </p>
    <noscript><div class="alert alert-warning">@L["site.files.noScript"]</div></noscript>
</div>
</section>

<section class="tab-panel" data-tab="security" hidden="@(Model.Tab != "security")">
<details class="card section" data-section="visibility" open="@Sections.IsOpen(HttpContext, "visibility")">
    <summary class="section-head"><h2>
        @L["site.visibility.title"]
        @if (Model.Site.IsPasscodeProtected)
        {
            <span class="badge badge-warn">@L["site.visibility.badgePasscode"]</span>
        }
        else
        {
            <span class="badge">@L["site.visibility.badgePublic"]</span>
        }
    </h2></summary>

    @if (Model.Site.IsPasscodeProtected)
    {
        <p class="hint">
            @L.Text("site.visibility.privateHint", new
            {
                date = Model.Site.PasscodeSetUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—",
                name = Model.Site.PasscodeSetBy ?? L.Text("site.visibility.unknownPerson")
            })
        </p>
    }
    else
    {
        <p class="hint">
            @L["site.visibility.publicHint"]
        </p>
    }

    <form method="post" asp-page-handler="SetPasscode" asp-route-domain="@Model.Site.Domain">
        <div class="row">
            <div class="field">
                <label for="passcode">@(Model.Site.IsPasscodeProtected ? L["site.visibility.newPasscode"] : L["site.visibility.passcode"])</label>
                <input id="passcode" name="passcode" type="text" autocomplete="off" spellcheck="false"
                       minlength="@Model.MinPasscodeLength" maxlength="200"
                       placeholder="@L.Plural("site.visibility.minLength", Model.MinPasscodeLength)" required />
            </div>
            <button type="submit" class="btn-primary">@(Model.Site.IsPasscodeProtected ? L["site.visibility.change"] : L["site.visibility.set"])</button>
        </div>
    </form>

    <p class="hint" style="margin: 0.75rem 0 0">
        @L.Text("site.visibility.storedHint", new { duration = Model.PasscodeSession })
    </p>

    @if (Model.Site.IsPasscodeProtected)
    {
        <form method="post" asp-page-handler="RemovePasscode" asp-route-domain="@Model.Site.Domain"
              data-confirm="@L.Text("site.visibility.removeConfirm", new { domain = Model.Site.Domain })">
            <button type="submit" class="btn-danger">@L["site.visibility.remove"]</button>
        </form>
    }
</details>

@{
    var tls = Model.Site.Tls;
    var cert = Model.Certificate;
    var wantedSource = tls?.Source ?? CertificateSources.Automatic;

    // A certificate source's name, in the viewer's language.
    string SourceName(string? source) => CertificateSourceNames.Of(L, source);
}
<details class="card section" id="https" data-section="https" open="@Sections.IsOpen(HttpContext, "https")">
    <summary class="section-head"><h2>
        @L["site.https.title"]
        @if (!Model.HttpsInServer)
        {
            <span class="badge">@L["site.https.badgeOutside"]</span>
        }
        else if (cert?.Served is { } served)
        {
            <span class="badge @(served.SelfSigned ? "badge-warn" : "badge-ok")">@SourceName(cert.ServedSource ?? cert.Effective)</span>
        }
        else if (cert?.Effective == CertificateSources.None)
        {
            <span class="badge">@L["common.off"]</span>
        }
        else if (cert?.State.LastError is not null || cert?.Problem is not null)
        {
            <span class="badge badge-error">@L["site.https.badgeNoCertificate"]</span>
        }
        else
        {
            <span class="badge">@L["site.https.badgeWaiting"]</span>
        }
    </h2></summary>

    @if (!Model.HttpsInServer)
    {
        <p class="hint">
            @L.Html("site.https.outsideHint")
        </p>
    }
    else if (cert is not null)
    {
        <dl class="tls-facts">
            <dt>@L["site.https.certificate"]</dt>
            <dd>
                @if (cert.Served is { } served)
                {
                    <span>@L.Html("site.https.served", new { source = SourceName(cert.ServedSource), issuer = served.Issuer, names = string.Join(", ", served.Names) })
                        @L.Plural("site.https.expires", (int)Math.Floor((served.NotAfter - DateTimeOffset.UtcNow).TotalDays), new { date = served.NotAfter.ToLocalTime().ToString("yyyy-MM-dd") })
                        @if (cert.RenewsAt is { } renews)
                        {
                            @L.Text("site.https.renews", new { date = renews.ToLocalTime().ToString("yyyy-MM-dd") })
                        }</span>
                    @if (served.SelfSigned)
                    {
                        <span class="muted">@L["site.https.selfSignedNote"]</span>
                    }
                }
                else if (cert.Effective == CertificateSources.None)
                {
                    <span class="muted">@L["site.https.plainHttp"]</span>
                }
                else
                {
                    <span class="muted">@L["site.https.noneYet"]</span>
                }
            </dd>
            <dt>@L["site.https.sourceLabel"]</dt>
            <dd>
                @(cert.Wanted != cert.Effective
                    ? L.Text("site.https.sourceMeans", new { wanted = SourceName(cert.Wanted), effective = SourceName(cert.Effective) })
                    : L.Text("site.https.sourceSame", new { source = SourceName(cert.Wanted) }))
                @if (cert.Busy)
                {
                    <span class="badge">@L["site.https.busy"]</span>
                }
            </dd>
        </dl>

        @if (cert.Problem is { } problem)
        {
            <div class="alert alert-error">@problem</div>
        }
        else if (cert.State.LastError is { } lastError)
        {
            <div class="alert alert-error">
                @L.Html("site.https.lastFailed", new { date = cert.State.LastAttemptUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm"), error = lastError })
                @if (cert.State.NextAttemptUtc is { } next)
                {
                    <br /><span>@L.Html("site.https.nextAttempt", new { date = next.ToLocalTime().ToString("yyyy-MM-dd HH:mm") })</span>
                }
            </div>
        }
    }

    @if (Model.TlsError is { } tlsError)
    {
        <div class="alert alert-error">@tlsError</div>
    }

    @if (Model.IsAdministrator)
    {
        <form method="post" asp-page-handler="Tls" asp-route-domain="@Model.Site.Domain">
            @if (Model.HttpsInServer)
            {
                <div class="field" style="max-width: 26rem">
                    <label for="tls-source">@L["site.https.sourceField"]</label>
                    <select id="tls-source" name="source">
                        <option value="automatic" selected="@(wantedSource == CertificateSources.Automatic)">@L["site.https.option.automatic"]</option>
                        <option value="letsencrypt" selected="@(wantedSource == CertificateSources.LetsEncrypt)">@L["site.https.option.letsEncrypt"]</option>
                        <option value="selfsigned" selected="@(wantedSource == CertificateSources.SelfSigned)">@L["site.https.option.selfSigned"]</option>
                        <option value="shared" selected="@(wantedSource == CertificateSources.Shared)">@L["site.https.option.shared"]</option>
                        @if (cert?.ServedSource == CertificateSources.Uploaded || wantedSource == CertificateSources.Uploaded)
                        {
                            <option value="uploaded" selected="@(wantedSource == CertificateSources.Uploaded)">@L["site.https.option.uploaded"]</option>
                        }
                        <option value="none" selected="@(wantedSource == CertificateSources.None)">@L["site.https.option.none"]</option>
                    </select>
                    <p class="hint" style="margin: 0.35rem 0 0">
                        @L.Html("site.https.automaticHint")
                    </p>
                </div>
                <div class="checkline" style="margin-top: 0.75rem">
                    <input id="tls-redirect" name="redirectToHttps" type="checkbox" value="true" checked="@(tls?.RedirectToHttps ?? true)" />
                    <label for="tls-redirect">@L["site.https.redirect"]</label>
                </div>
                <input type="hidden" name="redirectToHttps" value="false" />
            }
            else
            {
                <input type="hidden" name="redirectToHttps" value="@((tls?.RedirectToHttps ?? true) ? "true" : "false")" />
            }
            <div class="checkline" style="margin-top: 0.5rem">
                <input id="tls-hsts" name="hsts" type="checkbox" value="true" checked="@(tls?.Hsts ?? false)" />
                <label for="tls-hsts">@L["site.https.hsts"]</label>
            </div>
            <input type="hidden" name="hsts" value="false" />
            <p class="hint" style="margin-top: 0.35rem">
                @L["site.https.hstsHint"]
            </p>
            <button type="submit" class="btn-primary">@L["site.https.save"]</button>
        </form>

        @if (Model.HttpsInServer)
        {
            <div class="tls-actions">
                @if (cert?.Effective is CertificateSources.LetsEncrypt or CertificateSources.SelfSigned && cert.Problem is null)
                {
                    <form method="post" asp-page-handler="RenewCertificate" asp-route-domain="@Model.Site.Domain">
                        <button type="submit" class="btn">@L["site.https.renew"]</button>
                    </form>
                }
                @if (cert?.ServedSource == CertificateSources.Uploaded || wantedSource == CertificateSources.Uploaded)
                {
                    <form method="post" asp-page-handler="RemoveCertificate" asp-route-domain="@Model.Site.Domain"
                          data-confirm="@L.Text("site.https.removeConfirm", new { domain = Model.Site.Domain })">
                        <button type="submit" class="btn-danger">@L["site.https.remove"]</button>
                    </form>
                }
            </div>

            <details class="tls-upload">
                <summary>@L["site.https.upload"]</summary>
                <form method="post" asp-page-handler="UploadCertificate" asp-route-domain="@Model.Site.Domain">
                    <p class="hint">
                        @L.Html("site.https.uploadHint")
                    </p>
                    <div class="field">
                        <label for="tls-certificate">@L["site.https.certificateField"]</label>
                        <textarea id="tls-certificate" name="certificate" class="rules" rows="5" wrap="off" spellcheck="false"
                                  placeholder="-----BEGIN CERTIFICATE-----"></textarea>
                    </div>
                    <div class="field">
                        <label for="tls-key">@L["site.https.privateKey"]</label>
                        <textarea id="tls-key" name="privateKey" class="rules" rows="5" wrap="off" spellcheck="false" autocomplete="off"
                                  placeholder="-----BEGIN PRIVATE KEY-----"></textarea>
                    </div>
                    <button type="submit" class="btn-primary">@L["site.https.uploadButton"]</button>
                </form>
            </details>
        }
    }
</details>
</section>

<section class="tab-panel" data-tab="routing" hidden="@(Model.Tab != "routing")">
<details class="card section" id="proxy" data-section="proxy" open="@Sections.IsOpen(HttpContext, "proxy")">
    <summary class="section-head"><h2>
        @L["site.proxy.title"]
        @if (Model.Site.Proxy.Count > 0)
        {
            <span class="badge badge-ok">@L.Plural("site.proxy.routeCount", Model.Site.Proxy.Count)</span>
        }
        else
        {
            <span class="badge">@L["common.none"]</span>
        }
    </h2></summary>
    <p class="hint">
        @L["site.proxy.hint"]
    </p>

    @if (Model.ProxyUnsetEnvironment.Count > 0)
    {
        <div class="alert alert-warning">
            @L.PluralHtml("site.proxy.unsetEnvironment", Model.ProxyUnsetEnvironment.Count, new { names = string.Join(", ", Model.ProxyUnsetEnvironment) })
        </div>
    }

    @if (Model.ServerRoutes.Count > 0)
    {
        <div class="proxy-inherited">
            <p class="hint">
                @L.Html("site.proxy.serverHint")
            </p>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>@L["site.proxy.column.path"]</th>
                            <th>@L["site.proxy.column.target"]</th>
                            <th>@L["site.proxy.column.sites"]</th>
                            <th>@L["site.proxy.column.here"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (route, state) in Model.ServerRoutes)
                        {
                            var off = Model.Site.DisabledServerRoutes.Contains(route.Path, StringComparer.OrdinalIgnoreCase);
                            <tr>
                                <td class="mono">@route.Path</td>
                                <td class="mono">@route.Target</td>
                                <td class="mono muted">@route.Sites</td>
                                <td>
                                    @if (state == ProxySites.StateOn)
                                    {
                                        <span class="badge badge-ok">@L["common.on"]</span>
                                    }
                                    else
                                    {
                                        <span class="muted">@ProxyStateNames.Of(L, state)</span>
                                    }
                                </td>
                                <td class="actions">
                                    @if (Model.IsAdministrator)
                                    {
                                        <form method="post" asp-page-handler="ServerRoute" asp-route-domain="@Model.Site.Domain">
                                            <input type="hidden" name="path" value="@route.Path" />
                                            <input type="hidden" name="enabled" value="@(off ? "true" : "false")" />
                                            <button type="submit" class="btn btn-sm">@(off ? L["site.proxy.turnOn"] : L["site.proxy.turnOff"])</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.IsAdministrator)
    {
        @foreach (var editor in Model.ProxyEditors.Where(e => !e.IsNew))
        {
            var route = editor.Route;
            <details class="proxy-route" open="@(editor.Errors.Count > 0 || editor.TestResult is not null)">
                <summary>
                    <span class="mono">@editor.OriginalPath</span>
                    <span class="muted">→</span>
                    <span class="mono proxy-target">@route.Target</span>
                    @if (!route.Enabled)
                    {
                        <span class="badge badge-warn">@L["common.off"]</span>
                    }
                    @if (route.WebSockets)
                    {
                        <span class="badge">@L["site.proxy.badge.webSockets"]</span>
                    }
                    @if (route.Streaming)
                    {
                        <span class="badge">@L["site.proxy.badge.streaming"]</span>
                    }
                    @if (route.GrpcWeb)
                    {
                        <span class="badge">@L["site.proxy.badge.grpcWeb"]</span>
                    }
                    @if (route.HttpVersion == StaticSiteHost.Models.ProxyHttpVersions.Http2)
                    {
                        <span class="badge">@L["site.proxy.badge.http2"]</span>
                    }
                    @if (route.FilesFirst)
                    {
                        <span class="badge">@L["site.proxy.badge.filesFirst"]</span>
                    }
                </summary>
                <partial name="_ProxyRoute" model="editor" />
            </details>
        }

        var adding = Model.ProxyEditors.Single(e => e.IsNew);
        <details class="proxy-route proxy-add" open="@(Model.Site.Proxy.Count == 0 || adding.Errors.Count > 0)">
            <summary>@L["site.proxy.add"]</summary>
            <partial name="_ProxyRoute" model="adding" />
        </details>
    }
    else if (Model.Site.Proxy.Count > 0)
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>@L["site.proxy.column.path"]</th>
                        <th>@L["site.proxy.column.target"]</th>
                        <th>@L["site.proxy.column.settings"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var route in Model.Site.Proxy)
                    {
                        <tr>
                            <td class="mono">@route.Path</td>
                            <td class="mono">@route.Target</td>
                            <td class="muted">
                                @(string.Join(", ", new[]
                                {
                                    route.Enabled ? null : L.Text("common.off"),
                                    route.StripPath ? L.Text("site.proxy.pathRemoved") : L.Text("site.proxy.pathKept"),
                                    route.WebSockets ? L.Text("site.proxy.badge.webSockets") : null,
                                    route.Streaming ? L.Text("site.proxy.badge.streaming") : null,
                                    route.GrpcWeb ? L.Text("site.proxy.badge.grpcWeb") : null,
                                    route.HttpVersion == StaticSiteHost.Models.ProxyHttpVersions.Http2 ? L.Text("site.proxy.badge.http2") : null,
                                    route.FilesFirst ? L.Text("site.proxy.badge.filesFirst") : null,
                                    L.Text("site.proxy.timeout", new { seconds = route.TimeoutSeconds })
                                }.Where(part => part is not null)))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="hint" style="margin: 0.75rem 0 0">@L["site.proxy.memberHint"]</p>
    }
    else
    {
        <p class="muted">@L["site.proxy.memberEmpty"]</p>
    }
</details>

<details class="card section" data-section="headers" open="@Sections.IsOpen(HttpContext, "headers")">
    <summary class="section-head"><h2>@L["site.headers.title"]</h2></summary>
    <p class="hint">
        @L.Html("site.headers.hint", new { seconds = Model.AssetCacheSeconds })
    </p>

    @if (Model.HeaderRuleErrors.Count > 0)
    {
        <div class="alert alert-error">
            <strong>@L["site.headers.notSaved"]</strong>
            <ul>
                @foreach (var error in Model.HeaderRuleErrors.Take(8))
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="examples">
        <p class="examples-label">@L["site.headers.examplesLabel"]</p>
        <div class="examples-list">
            @foreach (var example in DetailsModel.HeaderExamples)
            {
                <button type="button" class="btn btn-sm" title="@L[example.HintKey]"
                        data-insert="@example.Snippet" data-insert-into="#header-rules">@L[example.LabelKey]</button>
            }
        </div>
    </div>

    <form method="post" asp-page-handler="Headers" asp-route-domain="@Model.Site.Domain">
        <div class="field">
            <label for="header-rules">@L["site.headers.rules"]</label>
            <textarea id="header-rules" name="rules" class="rules" rows="8" wrap="off" spellcheck="false"
                      placeholder="/*.json&#10;  Cache-Control: no-cache">@Model.HeaderRules</textarea>
        </div>
        <button type="submit" class="btn-primary">@L["site.headers.save"]</button>
    </form>

    <details class="rule-help">
        <summary>@L["site.headers.helpTitle"]</summary>
        <pre class="rule-help-sample">/assets/**
  Cache-Control: public, max-age=31536000, immutable

# a comment
/*.json
  Cache-Control: no-cache
  X-Generated-By: ci</pre>
        <ul>
            <li>@L.Html("site.headers.help.rule")</li>
            <li>@L.Html("site.headers.help.comment")</li>
            <li>@L.Html("site.headers.help.pattern")</li>
            <li>@L.Html("site.headers.help.file")</li>
            <li>@L["site.headers.help.order"]</li>
            <li>@L.Html("site.headers.help.noCache")</li>
            <li>@L.Html("site.headers.help.reserved")</li>
        </ul>
    </details>

    @if (Model.ReleaseHeaderRules.Count > 0)
    {
        <div class="from-release">
            <p class="hint">
                @L.Html("site.headers.fromRelease")
            </p>
            <pre class="rules-readonly">@StaticSiteHost.Serving.HeaderRuleText.Format(Model.ReleaseHeaderRules)</pre>
        </div>
    }
</details>

<details class="card section" data-section="redirects" open="@Sections.IsOpen(HttpContext, "redirects")">
    <summary class="section-head"><h2>@L["site.redirects.title"]</h2></summary>
    <p class="hint">
        @L.Html("site.redirects.hint")
    </p>

    @if (Model.RedirectRuleErrors.Count > 0)
    {
        <div class="alert alert-error">
            <strong>@L["site.redirects.notSaved"]</strong>
            <ul>
                @foreach (var error in Model.RedirectRuleErrors.Take(8))
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="examples">
        <p class="examples-label">@L["site.redirects.examplesLabel"]</p>
        <div class="examples-list">
            @foreach (var example in DetailsModel.RedirectExamples)
            {
                <button type="button" class="btn btn-sm" title="@L[example.HintKey]"
                        data-insert="@example.Snippet" data-insert-into="#redirect-rules">@L[example.LabelKey]</button>
            }
        </div>
    </div>

    <form method="post" asp-page-handler="Redirects" asp-route-domain="@Model.Site.Domain">
        <div class="field">
            <label for="redirect-rules">@L["site.redirects.rules"]</label>
            <textarea id="redirect-rules" name="rules" class="rules" rows="8" wrap="off" spellcheck="false"
                      placeholder="/old-page  /new-page  301">@Model.RedirectRules</textarea>
