    <details class="rule-help">
        <summary>@L["site.redirects.helpTitle"]</summary>
        <pre class="rule-help-sample">from       to                            status

/old-page  /new-page                     301
/blog/*    /articles/:1                  301
/docs/**   https://docs.example.com/:1   302
/app/**    /app/index.html               200
/removed   /404.html                     404
/legacy/*  /new/:1                       301!</pre>
        <ul>
            <li>@L.Html("site.redirects.help.line")</li>
            <li>@L.Html("site.redirects.help.pattern")</li>
            <li>@L.Html("site.redirects.help.first")</li>
            <li>@L.Html("site.redirects.help.files")</li>
            <li>@L.Html("site.redirects.help.where")</li>
            <li>@L["site.redirects.help.loop"]</li>
            <li>@L.Html("site.redirects.help.cache")</li>
            <li>@L.Html("site.redirects.help.index")</li>
        </ul>
    </details>

    @if (Model.ReleaseRedirectRules.Count > 0)
    {
        <div class="from-release">
            <p class="hint">
                @L.Html("site.redirects.fromRelease")
            </p>
            <pre class="rules-readonly">@StaticSiteHost.Serving.RedirectRuleText.Format(Model.ReleaseRedirectRules)</pre>
        </div>
    }
</details>
</section>

<section class="tab-panel" data-tab="app" hidden="@(Model.Tab != "app")">
<details class="card section" id="functions" data-section="functions" open="@Sections.IsOpen(HttpContext, "functions")">
    <summary class="section-head"><h2>@L["site.functions.title"]</h2></summary>
    <p class="hint">
        @L.Html("site.functions.hint")
    </p>

    <partial name="_FunctionErrors" model="new StaticSiteHost.Pages.Shared.FunctionErrorsView(Model.FunctionError, Model.FunctionDiagnostics)" />

    @if (Model.Site.CurrentFunctions is { } bundle)
    {
        // Editing and removing files is for administrators; everyone else sees plain names.
        var view = new StaticSiteHost.Pages.Shared.FunctionBundleView(
            bundle, url,
            Url.Page(null, "FunctionSource", new { domain = Model.Site.Domain })!,
            Model.IsAdministrator ? Url.Page("/Admin/FunctionEditor", new { domain = Model.Site.Domain }) : null,
            Model.IsAdministrator ? Url.Page(null, "RemoveFunctionFile", new { domain = Model.Site.Domain }) : null,
            Model.FunctionsStatus);
        <partial name="_FunctionBundle" model="view" />
    }
    else
    {
        <p class="muted">@L["site.functions.none"]</p>
    }

    @if (Model.IsAdministrator)
    {
        var upload = new StaticSiteHost.Pages.Shared.FunctionUploadView(
            Url.Page(null, "Functions", new { domain = Model.Site.Domain })!,
            Model.Site.CurrentFunctions,
            Url.Page("/Admin/FunctionEditor", new { domain = Model.Site.Domain })!,
            Url.Page(null, "RemoveFunctions", new { domain = Model.Site.Domain }),
            L.Text("site.functions.remove"),
            L.Text("site.functions.removeConfirm", new { domain = Model.Site.Domain }));
        <partial name="_FunctionUpload" model="upload" />
    }
    else
    {
        <p class="hint">@L["site.functions.memberHint"]</p>
    }
</details>

<details class="card section" id="variables" data-section="variables" open="@Sections.IsOpen(HttpContext, "variables")">
    <summary class="section-head"><h2>@L["site.variables.title"]</h2></summary>
    <p class="hint">
        @L.Html("site.variables.hint")
    </p>

    @if (Model.MissingVariables.Count > 0)
    {
        <div class="alert alert-warning">
            @L.PluralHtml("site.variables.missing", Model.MissingVariables.Count, new { names = string.Join(", ", Model.MissingVariables) })
        </div>
    }

    @if (Model.UnsetEnvironment.Count > 0)
    {
        <div class="alert alert-warning">
            @L.PluralHtml("site.variables.unsetEnvironment", Model.UnsetEnvironment.Count, new { names = string.Join(", ", Model.UnsetEnvironment) })
        </div>
    }

    @if (Model.Variables.Count > 0)
    {
        <div class="table-wrap">
            <table class="variables">
                <thead>
                    <tr>
                        <th>@L["site.variables.column.name"]</th>
                        <th>@L["site.variables.column.value"]</th>
                        <th>@L["site.variables.column.visibility"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var variable in Model.Variables)
                    {
                        var missing = Model.MissingVariables.Contains(variable.Name);
                        var source = variable.Source switch
                        {
                            SiteVariableService.SourceSite => L.Text("site.variables.source.site"),
                            SiteVariableService.SourceDefault => L.Text("site.variables.source.default"),
                            _ => L.Text("site.variables.source.none")
                        };
                        var confirm = !variable.IsDeclared
                            ? L.Text("site.variables.removeConfirm", new { name = variable.Name, domain = Model.Site.Domain })
                            : L.Text("site.variables.useDefaultConfirm", new { name = variable.Name });

                        <tr>
                            <td>
                                <span class="mono">@variable.Name</span>
                                @if (variable.Description.Length > 0)
                                {
                                    <div class="muted var-description">@variable.Description</div>
                                }
                            </td>
                            <td>
                                @if (variable.IsSecret)
                                {
                                    <span class="badge @(variable.HasValue ? "badge-ok" : "badge-warn")">@(variable.HasValue ? L["site.variables.secretSet"] : L["site.variables.secretNotSet"])</span>
                                }
                                else if (variable.Value is { Length: > 0 } shown)
                                {
                                    <span class="mono var-value">@shown</span>
                                }
                                else if (variable.Value is not null)
                                {
                                    <span class="muted">@L["site.variables.empty"]</span>
                                }
                                <div class="muted var-source">@source</div>
                                @foreach (var name in variable.UnsetEnvironment)
                                {
                                    <div class="var-note">@L.Html("site.variables.environmentNotSet", new { name })</div>
                                }
                            </td>
                            <td>
                                <span class="var-badges">
                                    @if (variable.IsPublic)
                                    {
                                        <span class="badge badge-ok">@L["site.variables.badge.public"]</span>
                                    }
                                    @if (variable.IsSecret)
                                    {
                                        <span class="badge badge-warn">@L["site.variables.badge.secret"]</span>
                                    }
                                    @if (variable.IsRequired)
                                    {
                                        <span class="badge @(missing ? "badge-off" : null)">@L["site.variables.badge.required"]</span>
                                    }
                                    @if (!variable.IsPublic && !variable.IsSecret)
                                    {
                                        <span class="muted">@L["site.variables.functionsOnly"]</span>
                                    }
                                </span>
                            </td>
                            <td class="actions">
                                @if (variable.IsAdministratorsOnly && !Model.IsAdministrator)
                                {
                                    @* A secret, or a value that reads the server's environment: the server refuses a member's change too. *@
                                    <span class="muted" title="@L["site.variables.administratorsOnlyTitle"]">@L["site.variables.administratorsOnly"]</span>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="SetVariable" asp-route-domain="@Model.Site.Domain" class="var-edit">
                                        <input type="hidden" name="name" value="@variable.Name" />
                                        @if (variable.IsSecret)
                                        {
                                            @* Never filled in: the value does not come back to the page, and an empty box leaves it alone. *@
                                            <input type="password" name="value" autocomplete="new-password" placeholder="@L["site.variables.unchanged"]"
                                                   aria-label="@L.Text("site.variables.newValueFor", new { name = variable.Name })" />
                                        }
                                        else
                                        {
                                            <input type="text" name="value" value="@variable.Value" autocomplete="off" spellcheck="false"
                                                   aria-label="@L.Text("site.variables.valueFor", new { name = variable.Name })" />
                                        }
                                        <button type="submit" class="btn btn-sm">@L["common.save"]</button>
                                    </form>
                                    @if (variable.Source == SiteVariableService.SourceSite)
                                    {
                                        <form method="post" asp-page-handler="RemoveVariable" asp-route-domain="@Model.Site.Domain"
                                              data-confirm="@confirm">
                                            <input type="hidden" name="name" value="@variable.Name" />
                                            <button type="submit" class="btn-link danger">@(variable.IsDeclared ? L["site.variables.useDefault"] : L["common.remove"])</button>
                                        </form>
                                    }
                                }
                                @if (Model.VariableError is not null && Model.VariableErrorFor == variable.Name)
                                {
                                    <div class="validation" role="alert">@Model.VariableError</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="muted">
            @L.Html("site.variables.none")
        </p>
    }

    <form method="post" asp-page-handler="SetVariable" asp-route-domain="@Model.Site.Domain" class="var-add">
        <h3>@L["site.variables.addTitle"]</h3>
        <p class="hint">
            @L["site.variables.addHint"]
            @if (!Model.IsAdministrator)
            {
                @L.Html("site.variables.addMemberHint")
            }
        </p>
        <div class="row">
            <div class="field">
                <label for="new-variable-name">@L["site.variables.name"]</label>
                <input id="new-variable-name" name="name" type="text" autocomplete="off" spellcheck="false" required
                       maxlength="64" pattern="[A-Za-z_][A-Za-z0-9_]*" placeholder="API_BASE_URL"
                       title="@L["site.variables.nameTitle"]"
                       value="@Model.NewVariableName" />
            </div>
            <div class="field">
                <label for="new-variable-value">@L["site.variables.value"]</label>
                <input id="new-variable-value" name="value" type="text" autocomplete="off" spellcheck="false"
                       value="@Model.NewVariableValue" />
            </div>
        </div>
        <div class="var-flags">
            @* Each checkbox is followed by a hidden "false", so an unticked box still says so. *@
            <div class="checkline">
                <input id="new-variable-public" name="isPublic" type="checkbox" value="true" checked="@Model.NewVariablePublic" />
                <label for="new-variable-public">@L.Html("site.variables.public")</label>
            </div>
            @if (Model.IsAdministrator)
            {
                <div class="checkline">
                    <input id="new-variable-secret" name="isSecret" type="checkbox" value="true" checked="@Model.NewVariableSecret" />
                    <label for="new-variable-secret">@L["site.variables.secret"]</label>
                </div>
            }
            <input type="hidden" name="isPublic" value="false" />
            <input type="hidden" name="isSecret" value="false" />
        </div>
        <button type="submit" class="btn-primary">@L["site.variables.add"]</button>
        @if (Model.VariableError is not null && Model.VariableErrorFor is null)
        {
            <div class="validation" role="alert">@Model.VariableError</div>
        }
    </form>
</details>

<details class="card section" id="ai" data-section="ai" open="@Sections.IsOpen(HttpContext, "ai")">
    <summary class="section-head"><h2>
        @L["site.ai.title"]
        @if (Model.AiProvider is null)
        {
            <span class="badge">@L["common.off"]</span>
        }
        else if (Model.AiAccessHook is not null)
        {
            <span class="badge badge-ok">@L["site.ai.badgeHook"]</span>
        }
        else if (Model.Site.Ai?.AllowVisitors == true)
        {
            <span class="badge badge-warn">@L["site.ai.badgeVisitors"]</span>
        }
        else
        {
            <span class="badge badge-ok">@L["site.ai.badgeFunctions"]</span>
        }
    </h2></summary>
    <p class="hint">
        @L.Html("site.ai.hint")
    </p>

    @if (Model.Site.Ai is { HasProvider: true } && Model.AiProvider is null)
    {
        <div class="alert alert-warning">
            @L["site.ai.providerDeleted"]
        </div>
    }

    @if (Model.IsAdministrator)
    {
        @if (Model.AiProviders.Count == 0)
        {
            <p class="muted">
                @L.Html("site.ai.noProviders", new { aiUrl = Url.Page("/Admin/Ai") })
            </p>
        }
        else
        {
            <form method="post" asp-page-handler="Ai" asp-route-domain="@Model.Site.Domain">
                <div class="row">
                    <div class="field">
                        <label for="ai-provider">@L["site.ai.provider"]</label>
                        <select id="ai-provider" name="providerId">
                            <option value="" selected="@(Model.AiProviderId is null)">@L["site.ai.noProvider"]</option>
                            @foreach (var provider in Model.AiProviders)
                            {
                                <option value="@provider.Id" data-model="@provider.DefaultModel"
                                        selected="@(provider.Id == Model.AiProviderId)">@provider.Name (@provider.DefaultModel)</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="ai-model">@L["site.ai.model"]</label>
                        <input id="ai-model" name="model" type="text" autocomplete="off" spellcheck="false"
                               data-model-suggest data-model-provider="#ai-provider"
                               maxlength="@SiteAiSettings.MaxModelLength" value="@Model.AiModelName"
                               placeholder="@(Model.AiProvider?.DefaultModel ?? L.Text("site.ai.modelPlaceholder"))" />
                    </div>
                </div>
                <div class="field ai-prompt">
                    <label for="ai-system-prompt">@L["site.ai.systemPrompt"]</label>
                    <textarea id="ai-system-prompt" name="systemPrompt" rows="4" spellcheck="true"
                              placeholder="@L["site.ai.systemPromptPlaceholder"]">@Model.AiSystemPrompt</textarea>
                    <p class="hint snippet-hint">
                        @L.Text("site.ai.systemPromptHint", new { size = Model.AiMaxSystemPromptBytes / 1024 })
                    </p>
                </div>
                <div class="checkline">
                    <input id="ai-allow-visitors" name="allowVisitors" type="checkbox" value="true" checked="@Model.AiAllowVisitors" />
                    <label for="ai-allow-visitors">@L.Html("site.ai.allowVisitors")</label>
                </div>
                <input type="hidden" name="allowVisitors" value="false" />
                @if (Model.AiAccessHook is not null)
                {
                    <p class="hint">
                        @L.Html("site.ai.hookHint", new { hook = Model.AiAccessHook })
                    </p>
                }
                <p class="hint ai-warning">
                    @(Model.AiVisitorRequestsPerMinute > 0
                        ? L.PluralHtml("site.ai.visitorWarning", Model.AiVisitorRequestsPerMinute)
                        : L.Html("site.ai.visitorWarningNoLimit"))
                </p>
                <button type="submit" class="btn-primary">@L["site.ai.save"]</button>
                @if (Model.AiError is not null)
                {
                    <div class="validation" role="alert">@Model.AiError</div>
                }
            </form>

            @if (Model.Site.Ai is not null)
            {
                <form method="post" asp-page-handler="RemoveAi" asp-route-domain="@Model.Site.Domain" class="ai-remove"
                      data-confirm="@L.Text("site.ai.removeConfirm", new { domain = Model.Site.Domain })">
                    <button type="submit" class="btn-danger">@L["site.ai.remove"]</button>
                </form>
            }
        }
    }
    else if (Model.AiProvider is not null)
    {
        <p>
            @L.Html("site.ai.memberProvider", new { provider = Model.AiProvider.Name, model = Model.Site.Ai?.Model ?? Model.AiProvider.DefaultModel })
            @(Model.AiAccessHook is not null
                ? L.Html("site.ai.memberHook", new { hook = Model.AiAccessHook })
                : Model.Site.Ai?.AllowVisitors == true
                    ? L.Html("site.ai.memberVisitors")
                    : L.Html("site.ai.memberNoVisitors"))
        </p>
        <p class="hint">@L["site.ai.memberHint"]</p>
    }
    else
    {
        <p class="muted">@L["site.ai.memberNone"]</p>
    }

    <details class="code-fold">
    <summary>@L["site.ai.codeTitle"]</summary>
    <div class="snippet">
        <div class="snippet-head">
            <label for="ai-snippet">@L["site.ai.snippetLabel"]</label>
            <button type="button" class="btn btn-sm" data-copy="#ai-snippet">@L["common.copy"]</button>
        </div>
        <textarea id="ai-snippet" rows="@(Model.AiSnippet.Count(c => c == '\n') + 1)" wrap="off" readonly spellcheck="false"
                  onclick="this.select()">@Model.AiSnippet</textarea>
        <p class="hint snippet-hint">
            @L.Html("site.ai.snippetHint")
        </p>
    </div>
    </details>
</details>

<details class="card section" id="realtime" data-section="realtime" open="@Sections.IsOpen(HttpContext, "realtime")">
    <summary class="section-head"><h2>
        @L["site.realtime.title"]
        @if (Model.RealtimeConnections > 0)
        {
            <span class="badge badge-ok">@L.Plural("site.realtime.connected", Model.RealtimeConnections, new { connections = Model.RealtimeConnections.ToString("N0") })</span>
        }
        else
        {
            <span class="badge">@L["site.realtime.noneConnected"]</span>
        }
    </h2></summary>
    <p class="hint">
        @L.Html("site.realtime.hint")
    </p>

    @if (Model.RealtimeConnections == 0)
    {
        <p class="muted">@L["site.realtime.noPages"]</p>
    }
    else
    {
        <p>
            @L.Plural("site.realtime.pages", Model.RealtimeConnections, new
            {
                pages = Model.RealtimeConnections.ToString("N0"),
                groups = L.Plural("site.realtime.groupCount", Model.RealtimeGroups.Count, new { number = Model.RealtimeGroups.Count.ToString("N0") })
            })
        </p>
    }

    @if (Model.RealtimeGroups.Count > 0)
    {
        <div class="table-wrap rt-groups">
            <table>
                <thead>
                    <tr>
                        <th>@L["site.realtime.column.group"]</th>
                        <th>@L["site.realtime.column.connections"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (name, members) in Model.RealtimeGroups.Take(DetailsModel.RealtimeGroupsShown))
                    {
                        <tr>
                            <td class="mono">@name</td>
                            <td>@members.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.RealtimeGroups.Count > DetailsModel.RealtimeGroupsShown)
        {
            <p class="hint">
                @L.PluralHtml("site.realtime.more", Model.RealtimeGroups.Count - DetailsModel.RealtimeGroupsShown, new
                {
                    more = (Model.RealtimeGroups.Count - DetailsModel.RealtimeGroupsShown).ToString("N0"),
                    domain = Model.Site.Domain
                })
            </p>
        }
    }

    <details class="code-fold">
        <summary>@L["site.realtime.codeTitle"]</summary>
        <div class="snippet">
            <div class="snippet-head">
                <label for="realtime-snippet">@L["site.realtime.listenLabel"]</label>
                <button type="button" class="btn btn-sm" data-copy="#realtime-snippet">@L["common.copy"]</button>
            </div>
            <textarea id="realtime-snippet" rows="@(Model.RealtimeSnippet.Count(c => c == '\n') + 1)" wrap="off" readonly spellcheck="false"
                      onclick="this.select()">@Model.RealtimeSnippet</textarea>
            <p class="hint snippet-hint">
                @L.Html("site.realtime.listenHint")
            </p>
        </div>
        <div class="snippet">
            <div class="snippet-head">
                <label for="realtime-publish-snippet">@L["site.realtime.publishLabel"]</label>
                <button type="button" class="btn btn-sm" data-copy="#realtime-publish-snippet">@L["common.copy"]</button>
            </div>
            <textarea id="realtime-publish-snippet" rows="@(Model.RealtimePublishSnippet.Count(c => c == '\n') + 1)" wrap="off"
                      readonly spellcheck="false" onclick="this.select()">@Model.RealtimePublishSnippet</textarea>
            <p class="hint snippet-hint">
                @L.Html("site.realtime.publishHint")
            </p>
        </div>
    </details>
</details>
</section>

<section class="tab-panel" data-tab="releases" hidden="@(Model.Tab != "releases")">
<details class="card section" data-section="releases" open="@Sections.IsOpen(HttpContext, "releases")">
    <summary class="section-head"><h2>@L["site.releases.title"]</h2></summary>
    <p class="hint">@L["site.releases.hint"]</p>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>@L["site.releases.column.release"]</th>
                    <th>@L["site.releases.column.contents"]</th>
                    <th>@L["site.releases.column.functions"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var release in Model.Site.Releases)
                {
                    <tr>
                        <td>
                            <span class="mono nowrap">@release.Id</span>
                            @if (release.Id == Model.Site.CurrentRelease)
                            {
                                <span class="badge badge-ok">@L["site.releases.live"]</span>
                            }
                            <div class="cell-sub">@L.Text("site.releases.deployedBy", new { date = release.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm"), name = release.DeployedBy ?? "—" })</div>
                            @if (release.CopiedFrom is { } copiedFrom)
                            {
                                <div class="cell-sub">@L.Html("site.releases.copyOf", new { id = copiedFrom })</div>
                            }
                            @if (release.EditedUtc is { } edited)
                            {
                                <div class="cell-sub">@L.Text("site.releases.edited", new { date = edited.ToLocalTime().ToString("yyyy-MM-dd HH:mm"), name = release.EditedBy ?? "—" })</div>
                            }
                        </td>
                        <td>
                            @if (release.IsFunctionsOnly)
                            {
                                <span class="muted">@L["site.releases.functionsOnly"]</span>
                            }
                            else
                            {
                                <span class="nowrap">@L.Plural("site.releases.files", release.FileCount, new { files = release.FileCount.ToString("N0"), size = Format.Bytes(release.TotalBytes) })</span>
                                <div class="cell-sub">@(release.ArchiveName ?? "—")</div>
                            }
                        </td>
                        <td class="mono muted">@(release.Functions is null ? "—" : Model.BundleLabel(release.Functions))</td>
                        <td class="actions release-actions">
                            @if (!release.IsFunctionsOnly)
                            {
                                <a class="btn-link" asp-page-handler="DownloadRelease" asp-route-domain="@Model.Site.Domain"
                                   asp-route-releaseId="@release.Id" title="@L["site.releases.downloadTitle"]">@L["site.releases.download"]</a>
                            }
                            <a class="btn-link" href="@Url.Page("/Sites/Details", new { domain = Model.Site.Domain, tab = "files" })?release=@release.Id">@L["site.releases.edit"]</a>
                            <form method="post" asp-page-handler="Duplicate" asp-route-domain="@Model.Site.Domain">
                                <input type="hidden" name="releaseId" value="@release.Id" />
                                <button type="submit" class="btn-link" title="@L["site.files.duplicateTitle"]">@L["site.releases.duplicate"]</button>
                            </form>
                            @if (release.Id != Model.Site.CurrentRelease)
                            {
                                <form method="post" asp-page-handler="Rollback" asp-route-domain="@Model.Site.Domain">
                                    <input type="hidden" name="releaseId" value="@release.Id" />
                                    @if (release.Functions != Model.Site.Current?.Functions)
                                    {
                                        @* The two releases run different code, so which one comes along is a real choice. *@
                                        <select name="functions" aria-label="@L.Text("site.releases.functionsLabel", new { id = release.Id })">
                                            <option value="restore" selected>@L.Text("site.releases.withOwn", new { functions = Model.BundleLabel(release.Functions) })</option>
                                            <option value="keep">@L.Text("site.releases.withLive", new { functions = Model.BundleLabel(Model.Site.Current?.Functions) })</option>
                                        </select>
                                    }
                                    <button type="submit" class="btn-link">@L["site.releases.makeLive"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</details>
</section>

@if (Model.IsAdministrator)
{
<section class="tab-panel" data-tab="settings" hidden="@(Model.Tab != "settings")">
    <div class="card" id="branding">
        <h2>
            @L["site.branding.title"]
            <span class="badge @(Model.Site.Branding is null ? null : "badge-admin")">@L[Model.Site.Branding is null ? "site.branding.badgeServer" : "site.branding.badgeOwn"]</span>
        </h2>
        <p class="hint">@L["site.branding.hint"]</p>
        @if (Model.Site.Branding is not null)
        {
            <form method="post" asp-page-handler="RemoveBranding" asp-route-domain="@Model.Site.Domain"
                  data-confirm="@L.Text("site.branding.removeConfirm", new { domain = Model.Site.Domain })">
                <button type="submit" class="btn">@L["site.branding.remove"]</button>
            </form>
        }
    </div>
    @if (Model.Branding is { } branding)
    {
        <partial name="_BrandingEditor" model="branding" />
    }

    <details class="card section" data-section="rename" open="@Sections.IsOpen(HttpContext, "rename")">
        <summary class="section-head"><h2>@L["site.rename.title"]</h2></summary>
        <p class="hint">
            @L.Text("site.rename.hint", new { domain = Model.Site.Domain })
        </p>
        <form method="post" asp-page-handler="Rename" asp-route-domain="@Model.Site.Domain"
              data-confirm="@L.Text("site.rename.confirm", new { domain = Model.Site.Domain })">
            <div class="row">
                <div class="field">
                    <label for="newDomain">@L["site.rename.newDomain"]</label>
                    <input id="newDomain" name="newDomain" type="text" autocomplete="off" spellcheck="false"
                           maxlength="253" placeholder="www.example.com" required />
                </div>
                <button type="submit" class="btn-primary">@L["site.rename.button"]</button>
            </div>
        </form>
    </details>

    <details class="card section" data-section="danger" open="@Sections.IsOpen(HttpContext, "danger")">
        <summary class="section-head"><h2>@L["site.delete.title"]</h2></summary>
        <p class="hint">@L["site.delete.hint"]</p>
        <form method="post" asp-page-handler="Delete" asp-route-domain="@Model.Site.Domain"
              data-confirm="@L.Text("site.delete.confirm", new { domain = Model.Site.Domain })">
            <button type="submit" class="btn-danger">@L["site.delete.button"]</button>
        </form>
    </details>
</section>
}

@section Scripts {
    <script src="~/js/files.js" asp-append-version="true"></script>
}
