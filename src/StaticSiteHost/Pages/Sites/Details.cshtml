@page "{domain}"
@model StaticSiteHost.Pages.Sites.DetailsModel
@{
    ViewData["Title"] = Model.Site.Domain;
    var url = SiteLinks.For(Request, Model.Site.Domain);
}

<div class="page-head">
    <h1>@Model.Site.Domain</h1>
    <p><a href="@url" target="_blank" rel="noopener">@url</a></p>
</div>

<div class="card">
    <h2>Current release</h2>
    @if (Model.Site.Current is { } current)
    {
        <p class="hint">
            <span class="mono">@current.Id</span> — @current.FileCount.ToString("N0") files, @Format.Bytes(current.TotalBytes),
            deployed @current.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") by @(current.DeployedBy ?? "unknown")
            via @current.Source.
        </p>
        @if (!current.HasRootIndex)
        {
            <div class="alert alert-warning">This release has no <span class="mono">index.html</span> at its root, so unmatched requests return 404.</div>
        }
        @if (current.StrippedRootFolder)
        {
            <p class="hint">The archive wrapped everything in a single folder, which was unwrapped during extraction.</p>
        }
    }
    else
    {
        <div class="alert alert-warning">No release is currently active for this domain.</div>
    }
    <a class="btn" asp-page="/Index">Deploy a new version</a>
</div>

<div class="card">
    <h2>Deploy from the command line</h2>
    <p class="hint">
        Already pointed at <span class="mono">@Model.Site.Domain</span> — paste one into a terminal or a
        CI job. Every deploy publishes a new release and the previous one stays here for rollback.
    </p>

    @if (Model.HasUsableApiKey)
    {
        <p class="hint">
            Both read your key from <span class="mono">$SSH_KEY</span>, so export it first:
            <span class="mono">export SSH_KEY=sshost_…</span>
        </p>
    }
    else
    {
        <div class="alert alert-warning">
            You have no active API key yet — <a asp-page="/Account/Index">create one</a>, then
            <span class="mono">export SSH_KEY=sshost_…</span> before running these.
        </div>
    }

    @foreach (var snippet in Model.DeploySnippets)
    {
        <div class="snippet">
            <div class="snippet-head">
                <label for="@snippet.Id">@snippet.Title</label>
                <button type="button" class="btn btn-sm" data-copy="#@snippet.Id">Copy</button>
            </div>
            <textarea id="@snippet.Id" rows="@snippet.Lines" wrap="off" readonly spellcheck="false"
                      onclick="this.select()">@snippet.Command</textarea>
            <p class="hint snippet-hint">@snippet.Hint</p>
        </div>
    }
</div>

<div class="card">
    <h2>
        Visibility
        @if (Model.Site.IsPasscodeProtected)
        {
            <span class="badge badge-warn">passcode</span>
        }
        else
        {
            <span class="badge">public</span>
        }
    </h2>

    @if (Model.Site.IsPasscodeProtected)
    {
        <p class="hint">
            Visitors must enter a passcode before anything on this site is served, and it is kept out of
            shared caches and search engines. Set
            @(Model.Site.PasscodeSetUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
            by @(Model.Site.PasscodeSetBy ?? "unknown").
        </p>
    }
    else
    {
        <p class="hint">
            Anyone with the link can read this site. Set a passcode to keep a private report or an
            unannounced idea from being readable by whoever finds the URL.
        </p>
    }

    <form method="post" asp-page-handler="SetPasscode" asp-route-domain="@Model.Site.Domain">
        <div class="row">
            <div class="field">
                <label for="passcode">@(Model.Site.IsPasscodeProtected ? "Replace the passcode" : "Passcode")</label>
                <input id="passcode" name="passcode" type="text" autocomplete="off" spellcheck="false"
                       minlength="@Model.MinPasscodeLength" maxlength="200"
                       placeholder="At least @Model.MinPasscodeLength characters" required />
            </div>
            <button type="submit" class="btn-primary">@(Model.Site.IsPasscodeProtected ? "Replace passcode" : "Set passcode")</button>
        </div>
    </form>

    <p class="hint" style="margin: 0.75rem 0 0">
        It is stored hashed and cannot be read back, so keep a copy wherever you keep the link.
        Everyone already inside stays in for @Model.PasscodeSession unless the passcode is changed or removed.
    </p>

    @if (Model.Site.IsPasscodeProtected)
    {
        <form method="post" asp-page-handler="RemovePasscode" asp-route-domain="@Model.Site.Domain"
              data-confirm="Remove the passcode from @Model.Site.Domain? Anyone with the link will be able to read it.">
            <button type="submit" class="btn-danger">Remove passcode</button>
        </form>
    }
</div>

<div class="card">
    <h2>Header rules</h2>
    <p class="hint">
        Response headers for the paths that match a pattern. This is how you turn caching off on a
        file that changes without its name changing, pin a fingerprinted asset for a year, or add a
        security header. By default HTML is <span class="mono">no-cache</span> and everything else is
        <span class="mono">public, max-age=@Model.AssetCacheSeconds</span>.
    </p>

    @if (Model.HeaderRuleErrors.Count > 0)
    {
        <div class="alert alert-error">
            <strong>Nothing was saved.</strong>
            <ul>
                @foreach (var error in Model.HeaderRuleErrors.Take(8))
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="examples">
        <p class="examples-label">Click to add an example, then edit it:</p>
        <div class="examples-list">
            @foreach (var example in DetailsModel.HeaderExamples)
            {
                <button type="button" class="btn btn-sm" title="@example.Hint"
                        data-insert="@example.Snippet" data-insert-into="#header-rules">@example.Label</button>
            }
        </div>
    </div>

    <form method="post" asp-page-handler="Headers" asp-route-domain="@Model.Site.Domain">
        <div class="field">
            <label for="header-rules">Rules for this site</label>
            <textarea id="header-rules" name="rules" class="rules" rows="8" wrap="off" spellcheck="false"
                      placeholder="/*.json&#10;  Cache-Control: no-cache">@Model.HeaderRules</textarea>
        </div>
        <button type="submit" class="btn-primary">Save header rules</button>
    </form>

    <details class="rule-help">
        <summary>How a header rule is written</summary>
        <pre class="rule-help-sample">/assets/**
  Cache-Control: public, max-age=31536000, immutable

# a comment
/*.json
  Cache-Control: no-cache
  X-Generated-By: ci</pre>
        <ul>
            <li>A line starting with <span class="mono">/</span> opens a rule. The indented
                <span class="mono">Name: value</span> lines under it are the headers it sets.</li>
            <li><span class="mono">#</span> starts a comment; blank lines are ignored.</li>
            <li>In a pattern <span class="mono">*</span> matches anything except
                <span class="mono">/</span>, <span class="mono">**</span> matches across
                <span class="mono">/</span>, and <span class="mono">?</span> matches one character.
                Matching ignores case.</li>
            <li>A rule matches the URL requested <em>or</em> the file that answered it, so
                <span class="mono">/index.html</span> also covers <span class="mono">/</span>.</li>
            <li>Every matching rule applies, top to bottom. When two name the same header the later one
                wins, and rules here run after any that came with the release.</li>
            <li><span class="mono">no-cache</span> means <em>revalidate every time</em>, not
                <em>never store</em> — ETags still work, so unchanged content costs a
                <span class="mono">304</span>. Use <span class="mono">no-store</span> when nothing may
                be kept at all.</li>
            <li>Headers the server owns cannot be set: <span class="mono">Content-Length</span>,
                <span class="mono">Transfer-Encoding</span>, <span class="mono">Connection</span>,
                <span class="mono">Content-Encoding</span>, <span class="mono">Set-Cookie</span>,
                <span class="mono">X-Content-Type-Options</span> and the other transport headers.</li>
        </ul>
    </details>

    @if (Model.ReleaseHeaderRules.Count > 0)
    {
        <div class="from-release">
            <p class="hint">
                The current release brought these in a <span class="mono">_headers</span> file. They run
                before the rules above, so a rule above wins wherever both set the same header.
            </p>
            <pre class="rules-readonly">@StaticSiteHost.Serving.HeaderRuleText.Format(Model.ReleaseHeaderRules)</pre>
        </div>
    }
</div>

<div class="card">
    <h2>Redirects and rewrites</h2>
    <p class="hint">
        Where a request should be answered from something other than the path it named.
        A <strong>redirect</strong> (<span class="mono">301</span>, <span class="mono">302</span>,
        <span class="mono">303</span>, <span class="mono">307</span>, <span class="mono">308</span>)
        sends the visitor to a new address and the URL bar changes. A <strong>rewrite</strong>
        (<span class="mono">200</span> or <span class="mono">404</span>) quietly serves a different file
        at the address they asked for.
    </p>

    @if (Model.RedirectRuleErrors.Count > 0)
    {
        <div class="alert alert-error">
            <strong>Nothing was saved.</strong>
            <ul>
                @foreach (var error in Model.RedirectRuleErrors.Take(8))
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="examples">
        <p class="examples-label">Click to add an example, then edit it:</p>
        <div class="examples-list">
            @foreach (var example in DetailsModel.RedirectExamples)
            {
                <button type="button" class="btn btn-sm" title="@example.Hint"
                        data-insert="@example.Snippet" data-insert-into="#redirect-rules">@example.Label</button>
            }
        </div>
    </div>

    <form method="post" asp-page-handler="Redirects" asp-route-domain="@Model.Site.Domain">
        <div class="field">
            <label for="redirect-rules">Rules for this site</label>
            <textarea id="redirect-rules" name="rules" class="rules" rows="8" wrap="off" spellcheck="false"
                      placeholder="/old-page  /new-page  301">@Model.RedirectRules</textarea>
        </div>
        <button type="submit" class="btn-primary">Save redirects</button>
    </form>

    <details class="rule-help">
        <summary>How a redirect is written</summary>
        <pre class="rule-help-sample">from       to                            status

/old-page  /new-page                     301
/blog/*    /articles/:1                  301
/docs/**   https://docs.example.com/:1   302
/app/**    /app/index.html               200
/removed   /404.html                     404
/legacy/*  /new/:1                       301!</pre>
        <ul>
            <li>One rule per line: where it comes from, where it goes, and the status. The status is
                optional and defaults to <span class="mono">301</span>.</li>
            <li>Patterns use the same <span class="mono">*</span> / <span class="mono">**</span> /
                <span class="mono">?</span> globs as header rules.
                <span class="mono">:1</span>…<span class="mono">:9</span> in the target stand for what
                each wildcard matched, in order, and <span class="mono">:splat</span> is another name for
                <span class="mono">:1</span>.</li>
            <li>The <strong>first</strong> rule that matches answers the request, so put specific rules
                above broad ones. Rules here are tried before any that came with the release.</li>
            <li>A rule <strong>stands aside for real content</strong>: if the site actually has a file at
                the requested path, that file is served instead. This is what stops a broad rule such as
                <span class="mono">/**</span> from swallowing your stylesheets. Put
                <span class="mono">!</span> after the status to apply it anyway.</li>
            <li>A redirect target may be a path on this site or a full <span class="mono">https://</span>
                address; a rewrite target must be a path here. The visitor's query string is carried
                across.</li>
            <li>A rewrite's target is resolved straight against the files, so one rewrite never triggers
                another and rules cannot loop.</li>
            <li>Browsers hold a <span class="mono">301</span> for a long time. Header rules apply to
                redirects too, so a matching <span class="mono">Cache-Control: no-store</span> above is
                what keeps a permanent redirect from outliving the decision to make it.</li>
            <li>You rarely need a catch-all rewrite to <span class="mono">index.html</span> — unmatched
                paths already fall back to it on their own.</li>
        </ul>
    </details>

    @if (Model.ReleaseRedirectRules.Count > 0)
    {
        <div class="from-release">
            <p class="hint">
                The current release brought these in a <span class="mono">_redirects</span> file. They are
                tried after the rules above.
            </p>
            <pre class="rules-readonly">@StaticSiteHost.Serving.RedirectRuleText.Format(Model.ReleaseRedirectRules)</pre>
        </div>
    }
</div>

<div class="card" id="variables">
    <h2>Variables</h2>
    <p class="hint">
        Named values the site's pages and functions read: a title, a contact address, an API key.
        A <span class="mono">_variables.json</span> file at the root of the zip declares them, with
        their defaults. A value set here belongs to the site, so it survives deploys and rollbacks.
        Public variables reach the browser through <span class="mono">/_host/site.js</span>, and
        functions see all of them, secrets included.
    </p>

    @if (Model.MissingVariables.Count > 0)
    {
        <div class="alert alert-warning">
            @(Model.MissingVariables.Count == 1 ? "A required variable is" : "Required variables are") empty:
            <span class="mono">@string.Join(", ", Model.MissingVariables)</span>.
            Set @(Model.MissingVariables.Count == 1 ? "it" : "them") below.
        </div>
    }

    @if (Model.UnsetEnvironment.Count > 0)
    {
        <div class="alert alert-warning">
            A value here reads @(Model.UnsetEnvironment.Count == 1 ? "an environment variable" : "environment variables")
            the server does not have, so @(Model.UnsetEnvironment.Count == 1 ? "it reads" : "they read") as empty:
            <span class="mono">@string.Join(", ", Model.UnsetEnvironment)</span>.
        </div>
    }

    @if (Model.Variables.Count > 0)
    {
        <div class="table-wrap">
            <table class="variables">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Value</th>
                        <th>Visibility</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var variable in Model.Variables)
                    {
                        var missing = Model.MissingVariables.Contains(variable.Name);
                        var source = variable.Source switch
                        {
                            SiteVariableService.SourceSite => "set here",
                            SiteVariableService.SourceDefault => "from the release default",
                            _ => "no value"
                        };
                        var confirm = !variable.IsDeclared
                            ? $"Remove {variable.Name} from {Model.Site.Domain}?"
                            : $"Drop the value set here for {variable.Name}? It falls back to the release's default, or to no value if the release gives none.";

                        <tr>
                            <td>
                                <span class="mono">@variable.Name</span>
                                @if (variable.Description.Length > 0)
                                {
                                    <div class="muted var-description">@variable.Description</div>
                                }
                            </td>
                            <td>
                                @if (variable.IsSecret)
                                {
                                    <span class="badge @(variable.HasValue ? "badge-ok" : "badge-warn")">@(variable.HasValue ? "set" : "not set")</span>
                                }
                                else if (variable.Value is { Length: > 0 } shown)
                                {
                                    <span class="mono var-value">@shown</span>
                                }
                                else if (variable.Value is not null)
                                {
                                    <span class="muted">empty</span>
                                }
                                <div class="muted var-source">@source</div>
                                @foreach (var name in variable.UnsetEnvironment)
                                {
                                    <div class="var-note"><span class="mono">@name</span> is not set on the server</div>
                                }
                            </td>
                            <td>
                                <span class="var-badges">
                                    @if (variable.IsPublic)
                                    {
                                        <span class="badge badge-ok">public</span>
                                    }
                                    @if (variable.IsSecret)
                                    {
                                        <span class="badge badge-warn">secret</span>
                                    }
                                    @if (variable.IsRequired)
                                    {
                                        <span class="badge @(missing ? "badge-off" : null)">required</span>
                                    }
                                    @if (!variable.IsPublic && !variable.IsSecret)
                                    {
                                        <span class="muted">functions only</span>
                                    }
                                </span>
                            </td>
                            <td class="actions">
                                @if (variable.IsAdministratorsOnly && !Model.IsAdministrator)
                                {
                                    @* A secret, or a value that reads the server's environment: the server refuses a member's change too. *@
                                    <span class="muted" title="A secret, or a value that reads the server's environment, is for an administrator to set, change or remove.">administrators only</span>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="SetVariable" asp-route-domain="@Model.Site.Domain" class="var-edit">
                                        <input type="hidden" name="name" value="@variable.Name" />
                                        @if (variable.IsSecret)
                                        {
                                            @* Never filled in: the value does not come back to the page, and an empty box leaves it alone. *@
                                            <input type="password" name="value" autocomplete="new-password" placeholder="unchanged"
                                                   aria-label="New value for @variable.Name" />
                                        }
                                        else
                                        {
                                            <input type="text" name="value" value="@variable.Value" autocomplete="off" spellcheck="false"
                                                   aria-label="Value for @variable.Name" />
                                        }
                                        <button type="submit" class="btn btn-sm">Save</button>
                                    </form>
                                    @if (variable.Source == SiteVariableService.SourceSite)
                                    {
                                        <form method="post" asp-page-handler="RemoveVariable" asp-route-domain="@Model.Site.Domain"
                                              data-confirm="@confirm">
                                            <input type="hidden" name="name" value="@variable.Name" />
                                            <button type="submit" class="btn-link danger">@(variable.IsDeclared ? "Use default" : "Remove")</button>
                                        </form>
                                    }
                                }
                                @if (Model.VariableError is not null && Model.VariableErrorFor == variable.Name)
                                {
                                    <div class="validation" role="alert">@Model.VariableError</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="muted">
            No variables yet. Declare them in a <span class="mono">_variables.json</span> file in the zip, or add one below.
        </p>
    }

    <form method="post" asp-page-handler="SetVariable" asp-route-domain="@Model.Site.Domain" class="var-add">
        <h3>Add a variable</h3>
        <p class="hint">
            For something the release does not declare. Names are case-sensitive.
            @if (!Model.IsAdministrator)
            {
                <text>Secrets, and values that read the server's environment with <span class="mono">${env:…}</span>, are for an administrator to set.</text>
            }
        </p>
        <div class="row">
            <div class="field">
                <label for="new-variable-name">Name</label>
                <input id="new-variable-name" name="name" type="text" autocomplete="off" spellcheck="false" required
                       maxlength="64" pattern="[A-Za-z_][A-Za-z0-9_]*" placeholder="API_BASE_URL"
                       title="Letters, digits and underscores, starting with a letter or an underscore"
                       value="@Model.NewVariableName" />
            </div>
            <div class="field">
                <label for="new-variable-value">Value</label>
                <input id="new-variable-value" name="value" type="text" autocomplete="off" spellcheck="false"
                       value="@Model.NewVariableValue" />
            </div>
        </div>
        <div class="var-flags">
            @* Each checkbox is followed by a hidden "false", so an unticked box still says so. *@
            <div class="checkline">
                <input id="new-variable-public" name="isPublic" type="checkbox" value="true" checked="@Model.NewVariablePublic" />
                <label for="new-variable-public">Public: sent to the browser in <span class="mono">/_host/site.js</span></label>
            </div>
            @if (Model.IsAdministrator)
            {
                <div class="checkline">
                    <input id="new-variable-secret" name="isSecret" type="checkbox" value="true" checked="@Model.NewVariableSecret" />
                    <label for="new-variable-secret">Secret: stored encrypted and never shown again</label>
                </div>
            }
            <input type="hidden" name="isPublic" value="false" />
            <input type="hidden" name="isSecret" value="false" />
        </div>
        <button type="submit" class="btn-primary">Add variable</button>
        @if (Model.VariableError is not null && Model.VariableErrorFor is null)
        {
            <div class="validation" role="alert">@Model.VariableError</div>
        }
    </form>
</div>

<div class="card" id="ai">
    <h2>
        AI
        @if (Model.AiProvider is null)
        {
            <span class="badge">off</span>
        }
        else if (Model.AiAccessHook is not null)
        {
            <span class="badge badge-ok">visitors decided by [AiAccess]</span>
        }
        else if (Model.Site.Ai?.AllowVisitors == true)
        {
            <span class="badge badge-warn">open to visitors</span>
        }
        else
        {
            <span class="badge badge-ok">functions only</span>
        }
    </h2>
    <p class="hint">
        Chat through one of the server's AI providers. The site's functions reach it as
        <span class="mono">IAiChat</span>, and its pages through <span class="mono">site.ai.chat</span> in
        <span class="mono">/_host/site.js</span>: every visitor's when they are allowed, or those the site's
        <span class="mono">[AiAccess]</span> hook lets in when its functions have one. The key stays on the
        server, and the model and the system prompt set here apply to every chat.
    </p>

    @if (Model.Site.Ai is { HasProvider: true } && Model.AiProvider is null)
    {
        <div class="alert alert-warning">
            The provider this site used was deleted, so it has no AI. Choose another below.
        </div>
    }

    @if (Model.IsAdministrator)
    {
        @if (Model.AiProviders.Count == 0)
        {
            <p class="muted">
                There are no AI providers yet. <a asp-page="/Admin/Ai">Add one under AI</a>, then choose it here.
            </p>
        }
        else
        {
            <form method="post" asp-page-handler="Ai" asp-route-domain="@Model.Site.Domain">
                <div class="row">
                    <div class="field">
                        <label for="ai-provider">Provider</label>
                        <select id="ai-provider" name="providerId">
                            <option value="" selected="@(Model.AiProviderId is null)">None</option>
                            @foreach (var provider in Model.AiProviders)
                            {
                                <option value="@provider.Id" data-model="@provider.DefaultModel"
                                        selected="@(provider.Id == Model.AiProviderId)">@provider.Name (@provider.DefaultModel)</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="ai-model">Model</label>
                        <input id="ai-model" name="model" type="text" autocomplete="off" spellcheck="false"
                               maxlength="@SiteAiSettings.MaxModelLength" value="@Model.AiModelName"
                               placeholder="@(Model.AiProvider?.DefaultModel ?? "the provider's default")" />
                    </div>
                </div>
                <div class="field ai-prompt">
                    <label for="ai-system-prompt">System prompt</label>
                    <textarea id="ai-system-prompt" name="systemPrompt" rows="4" spellcheck="true"
                              placeholder="You answer questions about this site, briefly and kindly.">@Model.AiSystemPrompt</textarea>
                    <p class="hint snippet-hint">
                        Sent ahead of every conversation, up to @(Model.AiMaxSystemPromptBytes / 1024) KB. A page or a function
                        can add instructions after it but cannot remove it.
                    </p>
                </div>
                <div class="checkline">
                    <input id="ai-allow-visitors" name="allowVisitors" type="checkbox" value="true" checked="@Model.AiAllowVisitors" />
                    <label for="ai-allow-visitors">Let every visitor chat through <span class="mono">/_host/ai/chat</span></label>
                </div>
                <input type="hidden" name="allowVisitors" value="false" />
                @if (Model.AiAccessHook is not null)
                {
                    <p class="hint">
                        Not consulted: which visitors may chat is decided by the site's <span class="mono">[AiAccess]</span>
                        hook, <span class="mono">@Model.AiAccessHook</span>, for as long as its live functions have it.
                        This setting applies again if a deploy takes the hook away.
                    </p>
                }
                <p class="hint ai-warning">
                    Every visitor's question is billed to the provider's key, and anyone who can load the site can ask.
                    @Model.AiVisitorLimit Leave it off to keep chat to the site's functions, which decide for themselves
                    who may ask.
                </p>
                <button type="submit" class="btn-primary">Save AI settings</button>
                @if (Model.AiError is not null)
                {
                    <div class="validation" role="alert">@Model.AiError</div>
                }
            </form>

            @if (Model.Site.Ai is not null)
            {
                <form method="post" asp-page-handler="RemoveAi" asp-route-domain="@Model.Site.Domain" class="ai-remove"
                      data-confirm="Remove the AI settings from @Model.Site.Domain? Its functions and pages will no longer be able to chat.">
                    <button type="submit" class="btn-danger">Remove AI</button>
                </form>
            }
        }
    }
    else if (Model.AiProvider is not null)
    {
        <p>
            Configured with <strong>@Model.AiProvider.Name</strong>
            (<span class="mono">@(Model.Site.Ai?.Model ?? Model.AiProvider.DefaultModel)</span>).
            @(Model.AiAccessHook is not null
                ? $"Which visitors' pages may chat is decided by the site's [AiAccess] hook, {Model.AiAccessHook}."
                : Model.Site.Ai?.AllowVisitors == true
                    ? "Visitors are allowed: pages on the site can chat."
                    : "Visitors are not allowed: only the site's functions can chat.")
        </p>
        <p class="hint">Only administrators can change the AI settings, because they spend the provider's key.</p>
    }
    else
    {
        <p class="muted">This site has no AI. Only administrators can set it up, because it spends a provider's key.</p>
    }

    <div class="snippet ai-snippet">
        <div class="snippet-head">
            <label for="ai-snippet">Chatting from a page</label>
            <button type="button" class="btn btn-sm" data-copy="#ai-snippet">Copy</button>
        </div>
        <textarea id="ai-snippet" rows="@(Model.AiSnippet.Count(c => c == '\n') + 1)" wrap="off" readonly spellcheck="false"
                  onclick="this.select()">@Model.AiSnippet</textarea>
        <p class="hint snippet-hint">
            <span class="mono">site.ai.enabled</span> says whether this page may chat. The promise resolves with the whole answer,
            the model and the tokens it cost.
        </p>
    </div>
</div>

<div class="card" id="realtime">
    <h2>
        Realtime
        @if (Model.RealtimeConnections > 0)
        {
            <span class="badge badge-ok">@Model.RealtimeConnections.ToString("N0") connected</span>
        }
        else
        {
            <span class="badge">none connected</span>
        }
    </h2>
    <p class="hint">
        Events from the server to the pages open on this site. A page listens with
        <span class="mono">site.realtime.on</span> from <span class="mono">/_host/site.js</span>, and can join groups to
        hear only what concerns it. The site's functions publish through <span class="mono">IRealtime</span>, and a
        CI job or a script through the API.
    </p>

    @if (Model.RealtimeConnections == 0)
    {
        <p class="muted">No page was connected when this page loaded.</p>
    }
    else
    {
        <p>
            @Model.RealtimeConnections.ToString("N0") @(Model.RealtimeConnections == 1 ? "page was" : "pages were") connected
            when this page loaded, in @Model.RealtimeGroups.Count.ToString("N0") @(Model.RealtimeGroups.Count == 1 ? "group" : "groups").
        </p>
    }

    @if (Model.RealtimeGroups.Count > 0)
    {
        <div class="table-wrap rt-groups">
            <table>
                <thead>
                    <tr>
                        <th>Group</th>
                        <th>Members</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (name, members) in Model.RealtimeGroups.Take(DetailsModel.RealtimeGroupsShown))
                    {
                        <tr>
                            <td class="mono">@name</td>
                            <td>@members.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.RealtimeGroups.Count > DetailsModel.RealtimeGroupsShown)
        {
            <p class="hint">
                …and @((Model.RealtimeGroups.Count - DetailsModel.RealtimeGroupsShown).ToString("N0")) more.
                <span class="mono">GET /api/v1/sites/@Model.Site.Domain/realtime</span> lists every one.
            </p>
        }
    }

    <div class="rt-snippets">
        <div class="snippet">
            <div class="snippet-head">
                <label for="realtime-snippet">Listening from a page</label>
                <button type="button" class="btn btn-sm" data-copy="#realtime-snippet">Copy</button>
            </div>
            <textarea id="realtime-snippet" rows="@(Model.RealtimeSnippet.Count(c => c == '\n') + 1)" wrap="off" readonly spellcheck="false"
                      onclick="this.select()">@Model.RealtimeSnippet</textarea>
            <p class="hint snippet-hint">
                The server sends <span class="mono">site.deployed</span> itself whenever a deploy, a rollback or new functions
                go live. The first <span class="mono">on</span> connects, and a dropped connection comes back on its own. A
                handler gets the event's payload, then <span class="mono">{ event, group }</span>.
            </p>
        </div>
        <div class="snippet">
            <div class="snippet-head">
                <label for="realtime-publish-snippet">Telling every open page, from a script or a CI job</label>
                <button type="button" class="btn btn-sm" data-copy="#realtime-publish-snippet">Copy</button>
            </div>
            <textarea id="realtime-publish-snippet" rows="@(Model.RealtimePublishSnippet.Count(c => c == '\n') + 1)" wrap="off"
                      readonly spellcheck="false" onclick="this.select()">@Model.RealtimePublishSnippet</textarea>
            <p class="hint snippet-hint">
                Add <span class="mono">"payload"</span> with any JSON the pages need, and <span class="mono">"group"</span>,
                <span class="mono">"user"</span> or <span class="mono">"connection"</span> to reach fewer of them. The answer
                says how many connections it was sent to.
            </p>
        </div>
    </div>
</div>

<div class="card" id="functions">
    <h2>Functions</h2>
    <p class="hint">
        C# handlers that answer requests on this site, checked before its files: <span class="mono">.cs</span> files
        or LINQPad <span class="mono">.linq</span> queries with public static methods marked
        <span class="mono">[HttpGet("/path")]</span>, <span class="mono">[HttpPost]</span> and so on. Upload them here,
        write and test them in the editor, or ship them in a zip's <span class="mono">_functions/</span> folder.
        They belong to the live release: deploying new content keeps them, and rolling back asks what to run.
    </p>

    <partial name="_FunctionErrors" model="new StaticSiteHost.Pages.Shared.FunctionErrorsView(Model.FunctionError, Model.FunctionDiagnostics)" />

    @if (Model.Site.CurrentFunctions is { } bundle)
    {
        // Editing and removing files is for administrators; everyone else sees plain names.
        var view = new StaticSiteHost.Pages.Shared.FunctionBundleView(
            bundle, url,
            Url.Page(null, "FunctionSource", new { domain = Model.Site.Domain })!,
            Model.IsAdministrator ? Url.Page("/Admin/FunctionEditor", new { domain = Model.Site.Domain }) : null,
            Model.IsAdministrator ? Url.Page(null, "RemoveFunctionFile", new { domain = Model.Site.Domain }) : null,
            Model.FunctionsStatus);
        <partial name="_FunctionBundle" model="view" />
    }
    else
    {
        <p class="muted">The live release runs no functions.</p>
    }

    @if (Model.IsAdministrator)
    {
        var upload = new StaticSiteHost.Pages.Shared.FunctionUploadView(
            Url.Page(null, "Functions", new { domain = Model.Site.Domain })!,
            Model.Site.CurrentFunctions,
            Url.Page("/Admin/FunctionEditor", new { domain = Model.Site.Domain })!,
            Url.Page(null, "RemoveFunctions", new { domain = Model.Site.Domain }),
            "Remove functions",
            $"Stop running functions on {Model.Site.Domain}? Earlier releases keep theirs.");
        <partial name="_FunctionUpload" model="upload" />
    }
    else
    {
        <p class="hint">Only administrators can upload functions, because they run as code inside this server.</p>
    }
</div>

<div class="card">
    <h2>Releases</h2>
    <p class="hint">Older releases stay on disk so you can switch back instantly.</p>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Release</th>
                    <th>Deployed</th>
                    <th>By</th>
                    <th>Files</th>
                    <th>Size</th>
                    <th>Archive</th>
                    <th>Functions</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var release in Model.Site.Releases)
                {
                    <tr>
                        <td class="mono nowrap">
                            @release.Id
                            @if (release.Id == Model.Site.CurrentRelease)
                            {
                                <span class="badge badge-ok">live</span>
                            }
                        </td>
                        <td class="nowrap muted">@release.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="muted">@(release.DeployedBy ?? "—")</td>
                        <td>@release.FileCount.ToString("N0")</td>
                        <td class="nowrap">@Format.Bytes(release.TotalBytes)</td>
                        <td class="muted">@(release.ArchiveName ?? "—")</td>
                        <td class="mono muted">@(release.Functions is null ? "—" : Model.BundleLabel(release.Functions))</td>
                        <td class="actions">
                            @if (release.Id != Model.Site.CurrentRelease)
                            {
                                <form method="post" asp-page-handler="Rollback" asp-route-domain="@Model.Site.Domain">
                                    <input type="hidden" name="releaseId" value="@release.Id" />
                                    @if (release.Functions != Model.Site.Current?.Functions)
                                    {
                                        @* The two releases run different code, so which one comes along is a real choice. *@
                                        <select name="functions" aria-label="Functions to run on release @release.Id">
                                            <option value="restore" selected>with its own: @Model.BundleLabel(release.Functions)</option>
                                            <option value="keep">with the current: @Model.BundleLabel(Model.Site.Current?.Functions)</option>
                                        </select>
                                    }
                                    <button type="submit" class="btn-link">Make live</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.IsAdministrator)
{
    <div class="card">
        <h2>Change domain</h2>
        <p class="hint">
            Moves the site, with every release, its rules and its passcode, to another domain.
            @Model.Site.Domain stops answering immediately and nothing redirects from it, so point
            DNS at this server first, and update any deploy scripts: API calls name the domain.
        </p>
        <form method="post" asp-page-handler="Rename" asp-route-domain="@Model.Site.Domain"
              data-confirm="Move @Model.Site.Domain to the new domain? The current address stops working immediately.">
            <div class="row">
                <div class="field">
                    <label for="newDomain">New domain</label>
                    <input id="newDomain" name="newDomain" type="text" autocomplete="off" spellcheck="false"
                           maxlength="253" placeholder="www.example.com" required />
                </div>
                <button type="submit" class="btn-primary">Change domain</button>
            </div>
        </form>
    </div>

    <div class="card">
        <h2>Danger zone</h2>
        <p class="hint">Removing a site deletes every release and all of its files from disk.</p>
        <form method="post" asp-page-handler="Delete" asp-route-domain="@Model.Site.Domain"
              data-confirm="Delete @Model.Site.Domain and all of its content? This cannot be undone.">
            <button type="submit" class="btn-danger">Delete this site</button>
        </form>
    </div>
}
