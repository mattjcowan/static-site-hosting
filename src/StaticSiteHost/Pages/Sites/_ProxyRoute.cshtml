@model StaticSiteHost.Pages.Sites.ProxyRouteEditor
@using StaticSiteHost.Models
@using Microsoft.AspNetCore.Html
@{
    var route = Model.Route;
    var id = Model.Id;

    void Switch(string name, bool value, IHtmlContent label, IHtmlContent hint)
    {
        <div class="proxy-switch">
            <div class="checkline">
                <input id="@id-@name" name="@name" type="checkbox" value="true" checked="@value" />
                <label for="@id-@name">@label</label>
            </div>
            <input type="hidden" name="@name" value="false" />
            <p class="hint">@hint</p>
        </div>
    }
}

<form method="post" asp-page-handler="SaveProxyRoute" asp-route-domain="@Model.Domain" class="proxy-form">
    @if (!Model.IsNew)
    {
        @* What the saved route is known by: a site's route by its path, a server-wide one by its id. *@
        <input type="hidden" name="@(Model.IsServer ? "routeId" : "originalPath")" value="@Model.OriginalPath" />
    }

    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-error">
            <strong>@L["site.route.notSaved"]</strong>
            <ul>
                @foreach (var error in Model.Errors.Take(8))
                {
                    @* The services' messages stay as they are; the body limit's is a string key. *@
                    <li>@(error == StaticSiteHost.Pages.Sites.ProxyRouteInput.BodyLimitErrorKey ? L.Text(error) : error)</li>
                }
            </ul>
        </div>
    }

    @if (route is ServerProxyRoute server)
    {
        <div class="field">
            <label for="@id-sites">@L["site.route.sites"]</label>
            <input id="@id-sites" name="Sites" type="text" value="@server.Sites" required autocomplete="off" autocapitalize="off"
                   spellcheck="false" placeholder="*.apps.example.com" />
            <p class="hint proxy-row-hint">
                @L.Html("site.route.sitesHint")
            </p>
        </div>
    }

    <div class="row">
        <div class="field proxy-path">
            <label for="@id-path">@L["site.route.path"]</label>
            <input id="@id-path" name="Path" type="text" value="@route.Path" required maxlength="@StaticSiteHost.Serving.ProxyRouteRules.MaxPathLength"
                   placeholder="/api" autocomplete="off" autocapitalize="off" spellcheck="false" />
        </div>
        <div class="field">
            <label for="@id-target">@L["site.route.target"]</label>
            <input id="@id-target" name="Target" type="text" value="@route.Target" required maxlength="@StaticSiteHost.Serving.ProxyRouteRules.MaxTargetLength"
                   placeholder="http://orders-api:8080" autocomplete="off" autocapitalize="off" spellcheck="false" />
        </div>
    </div>
    <p class="hint proxy-row-hint">
        @L.Html("site.route.pathHint")
    </p>

    <div class="proxy-switches">
        @{
            Switch("Enabled", route.Enabled, L.Html("site.route.enabled"),
                L.Html("site.route.enabledHint"));
            Switch("StripPath", route.StripPath, L.Html("site.route.stripPath"),
                L.Html("site.route.stripPathHint"));
            Switch("WebSockets", route.WebSockets, L.Html("site.route.webSockets"),
                L.Html("site.route.webSocketsHint"));
            Switch("CrossSiteWebSockets", route.CrossSiteWebSockets, L.Html("site.route.crossSiteWebSockets"),
                L.Html("site.route.crossSiteWebSocketsHint"));
            Switch("Streaming", route.Streaming, L.Html("site.route.streaming"),
                L.Html("site.route.streamingHint"));
            Switch("GrpcWeb", route.GrpcWeb, L.Html("site.route.grpcWeb"),
                L.Html("site.route.grpcWebHint"));
            Switch("FilesFirst", route.FilesFirst, L.Html("site.route.filesFirst"),
                L.Html("site.route.filesFirstHint"));
            Switch("ForwardedHeaders", route.ForwardedHeaders, L.Html("site.route.forwardedHeaders"),
                L.Html("site.route.forwardedHeadersHint"));
            Switch("KeepHost", route.KeepHost, L.Html("site.route.keepHost"),
                L.Html("site.route.keepHostHint"));
            Switch("RewriteRedirects", route.RewriteRedirects, L.Html("site.route.rewriteRedirects"),
                L.Html("site.route.rewriteRedirectsHint"));
            Switch("AcceptAnyCertificate", route.AcceptAnyCertificate, L.Html("site.route.acceptAnyCertificate"),
                L.Html("site.route.acceptAnyCertificateHint"));
        }
    </div>

    <div class="row proxy-settings">
        <div class="field">
            <label for="@id-version">@L["site.route.httpVersion"]</label>
            <select id="@id-version" name="HttpVersion">
                <option value="@ProxyHttpVersions.Auto" selected="@(route.HttpVersion == ProxyHttpVersions.Auto)">@L["site.route.httpVersionAuto"]</option>
                <option value="@ProxyHttpVersions.Http11" selected="@(route.HttpVersion == ProxyHttpVersions.Http11)">@L["site.route.httpVersion11"]</option>
                <option value="@ProxyHttpVersions.Http2" selected="@(route.HttpVersion == ProxyHttpVersions.Http2)">@L["site.route.httpVersion2"]</option>
            </select>
        </div>
        <div class="field">
            <label for="@id-timeout">@L["site.route.timeout"]</label>
            <input id="@id-timeout" name="TimeoutSeconds" type="number" min="1" max="@StaticSiteHost.Serving.ProxyRouteRules.MaxTimeoutSeconds"
                   value="@route.TimeoutSeconds" required />
        </div>
        <div class="field">
            <label for="@id-body">@L["site.route.bodyLimit"]</label>
            <input id="@id-body" name="MaxRequestBodyMegabytes" type="text" inputmode="decimal" autocomplete="off"
                   value="@(Model.BodyLimitText ?? StaticSiteHost.Pages.Sites.ProxyRouteInput.Megabytes(route.MaxRequestBodyBytes))"
                   placeholder="@L["site.route.bodyLimitPlaceholder"]" />
        </div>
    </div>
    <p class="hint proxy-row-hint">
        @L.Html("site.route.settingsHint")
    </p>

    <div class="row proxy-settings">
        <div class="field">
            <label for="@id-cookies">@L["site.route.cookies"]</label>
            <select id="@id-cookies" name="CookieMode">
                <option value="@ProxyCookieModes.Host" selected="@(route.CookieMode == ProxyCookieModes.Host)">@L["site.route.cookiesHost"]</option>
                <option value="@ProxyCookieModes.Keep" selected="@(route.CookieMode == ProxyCookieModes.Keep)">@L["site.route.cookiesKeep"]</option>
                <option value="@ProxyCookieModes.Parent" selected="@(route.CookieMode == ProxyCookieModes.Parent)">@L["site.route.cookiesParent"]</option>
            </select>
        </div>
        <div class="field">
            <label for="@id-parent">@L["site.route.parentDomain"]</label>
            <input id="@id-parent" name="CookieParentDomain" type="text" value="@route.CookieParentDomain"
                   placeholder="example.com" autocomplete="off" autocapitalize="off" spellcheck="false" />
        </div>
    </div>
    <p class="hint proxy-row-hint">
        @L.Html("site.route.cookiesHint")
    </p>

    <div class="field">
        <label for="@id-headers">@L["site.route.requestHeaders"]</label>
        <textarea id="@id-headers" name="RequestHeaders" class="rules" rows="3" wrap="off" spellcheck="false"
                  placeholder="X-Api-Key: ${env:ORDERS_API_KEY}&#10;X-Debug:">@Model.HeadersText</textarea>
        <p class="hint snippet-hint">
            @L.Html("site.route.requestHeadersHint")
        </p>
    </div>

    <button type="submit" class="btn-primary">@(Model.IsNew ? L["site.route.add"] : L["site.route.save"])</button>
</form>

@if (!Model.IsNew)
{
    <div class="proxy-actions">
        <form method="post" asp-page-handler="TestProxyRoute" asp-route-domain="@Model.Domain">
            <input type="hidden" name="@(Model.IsServer ? "id" : "path")" value="@Model.OriginalPath" />
            <button type="submit" class="btn">@L["common.test"]</button>
        </form>
        <form method="post" asp-page-handler="RemoveProxyRoute" asp-route-domain="@Model.Domain"
              data-confirm="@(Model.IsServer
                  ? L.Text("site.route.removeServerConfirm", new { path = route.Path, sites = ((ServerProxyRoute)route).Sites })
                  : L.Text("site.route.removeConfirm", new { path = Model.OriginalPath }))">
            <input type="hidden" name="@(Model.IsServer ? "id" : "path")" value="@Model.OriginalPath" />
            <button type="submit" class="btn-danger">@L["site.route.remove"]</button>
        </form>
    </div>
    @if (Model.TestResult is { } test)
    {
        <div class="alert @(test.Answered ? "alert-success" : "alert-error") proxy-test" role="status">@test.Message</div>
    }
}
