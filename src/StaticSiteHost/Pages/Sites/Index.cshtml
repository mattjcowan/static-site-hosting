@page
@model StaticSiteHost.Pages.Sites.IndexModel
@{
    ViewData["Title"] = L["sites.title"];
}

<div class="page-head">
    <h1>@L["sites.title"]</h1>
    <p>@L["sites.intro"]</p>
</div>

<div class="card">
    <h2>@L["sites.new.title"]</h2>
    <p class="hint">@L.Html("sites.new.hint", new { deployUrl = Url.Page("/Index") })</p>
    <form method="post" asp-page-handler="Create">
        <div class="row">
            <div class="field">
                <label for="new-domain">@L["sites.new.domain"]</label>
                <input id="new-domain" name="domain" type="text" placeholder="@L["sites.new.domainPlaceholder"]"
                       autocomplete="off" autocapitalize="off" spellcheck="false" required />
            </div>
            <button type="submit" class="btn-primary">@L["sites.new.create"]</button>
        </div>
    </form>
</div>

<div class="card">
    @if (Model.Sites.Count == 0)
    {
        <p class="empty">@L.Html("sites.empty", new { deployUrl = Url.Page("/Index") })</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>@L["sites.column.domain"]</th>
                        <th>@L["sites.column.files"]</th>
                        <th>@L["sites.column.size"]</th>
                        <th>@L["sites.column.updated"]</th>
                        <th>@L["sites.column.by"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var site in Model.Sites)
                    {
                        var release = site.Current;
                        <tr>
                            <td>
                                <a href="@SiteLinks.For(Request, site.Domain)" target="_blank" rel="noopener">@site.Domain</a>
                                @if (site.IsPasscodeProtected)
                                {
                                    <span class="badge badge-warn" title="@L["sites.badge.passcodeTitle"]">@L["sites.badge.passcode"]</span>
                                }
                                @if (site.Proxy.Count > 0)
                                {
                                    <span class="badge" title="@L["sites.badge.routesTitle"]">@L.Plural("sites.badge.routes", site.Proxy.Count)</span>
                                }
                            </td>
                            <td>@(release?.FileCount.ToString("N0") ?? "—")</td>
                            <td class="nowrap">@(release is null ? "—" : Format.Bytes(release.TotalBytes))</td>
                            <td class="nowrap muted">@(site.UpdatedUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td class="muted">@(site.LastDeployedBy ?? "—")</td>
                            <td class="actions">
                                <a class="btn btn-sm" asp-page="Details" asp-route-domain="@site.Domain">@L["sites.manage"]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
