@page
@model StaticSiteHost.Pages.Sites.IndexModel
@{
    ViewData["Title"] = "Sites";
}

<div class="page-head">
    <h1>Sites</h1>
    <p>Every domain this server answers for.</p>
</div>

<div class="card">
    <h2>New site</h2>
    <p class="hint">
        Creates a site with no files. Use it for a site made of proxy routes that forward paths to other servers,
        such as Docker containers or services on a private network, or to set a site up before its first deploy.
        To publish files, <a asp-page="/Index">deploy a zip</a> instead: that creates the site as well.
    </p>
    <form method="post" asp-page-handler="Create">
        <div class="row">
            <div class="field">
                <label for="new-domain">Domain</label>
                <input id="new-domain" name="domain" type="text" placeholder="app.example.com"
                       autocomplete="off" autocapitalize="off" spellcheck="false" required />
            </div>
            <button type="submit" class="btn-primary">Create site</button>
        </div>
    </form>
</div>

<div class="card">
    @if (Model.Sites.Count == 0)
    {
        <p class="empty">There are no sites yet. <a asp-page="/Index">Deploy your first site</a>, or create one above.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Domain</th>
                        <th>Files</th>
                        <th>Size</th>
                        <th>Updated</th>
                        <th>By</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var site in Model.Sites)
                    {
                        var release = site.Current;
                        <tr>
                            <td>
                                <a href="@SiteLinks.For(Request, site.Domain)" target="_blank" rel="noopener">@site.Domain</a>
                                @if (site.IsPasscodeProtected)
                                {
                                    <span class="badge badge-warn" title="Visitors must enter a passcode">passcode</span>
                                }
                                @if (site.Proxy.Count > 0)
                                {
                                    <span class="badge" title="Paths forwarded to other servers">@site.Proxy.Count proxy route@(site.Proxy.Count == 1 ? "" : "s")</span>
                                }
                            </td>
                            <td>@(release?.FileCount.ToString("N0") ?? "—")</td>
                            <td class="nowrap">@(release is null ? "—" : Format.Bytes(release.TotalBytes))</td>
                            <td class="nowrap muted">@(site.UpdatedUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td class="muted">@(site.LastDeployedBy ?? "—")</td>
                            <td class="actions">
                                <a class="btn btn-sm" asp-page="Details" asp-route-domain="@site.Domain">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
