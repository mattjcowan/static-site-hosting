@model StaticSiteHost.Pages.Shared.FunctionUploadView
@*
    One upload form for a site's functions and the global ones. The picker gets a line of its
    own, then (when something is live) the choice of merging or replacing, then the actions.
    The remove form is separate and empty; its button sits with the others through the form
    attribute, since forms cannot nest.
*@
<form method="post" enctype="multipart/form-data" class="fn-upload" action="@Model.Action" asp-antiforgery="true"
      data-busy="@L["functions.upload.busy"]">
    <div class="field">
        <span class="label">@L[Model.Live is null ? "functions.upload.labelNew" : "functions.upload.labelMore"]</span>
        @* Not "required": the input is hidden inside the drop zone, and a browser cannot point at a
           hidden field to say it is empty. app.js checks for files instead. *@
        <div class="dropzone dropzone-sm" data-dropzone tabindex="0" role="button" aria-label="@L["functions.upload.choose"]">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12" />
            </svg>
            <div>
                <strong data-dropzone-label>@L.Html("functions.upload.drop")</strong>
                <span data-dropzone-hint>@L["functions.upload.dropHint"]</span>
            </div>
            <input id="function-file" name="files" type="file" accept=".cs,.linq,.zip" multiple />
        </div>
        <p class="hint" style="margin-top: 0.4rem">@L.Html("functions.upload.hint", new { version = Model.HostAbstractionsVersion })</p>
    </div>

    @if (Model.Live is not null)
    {
        <fieldset class="fn-mode">
            <legend class="sr-only">@L["functions.upload.modeLegend"]</legend>
            <label class="checkline">
                <input type="radio" name="mode" value="merge" checked />
                <span>@L.Html("functions.upload.merge")</span>
            </label>
            <label class="checkline">
                <input type="radio" name="mode" value="replace" />
                <span>@L.Html("functions.upload.replace")</span>
            </label>
        </fieldset>
    }

    <div class="fn-actions">
        <button type="submit" class="btn-primary">@L["functions.upload.deploy"]</button>
        <a class="btn" href="@Model.EditorUrl">@L["functions.upload.openEditor"]</a>
        @if (Model.Live is not null && Model.RemoveAction is not null)
        {
            <button type="submit" form="remove-functions" class="btn-danger">@Model.RemoveLabel</button>
        }
    </div>
</form>

@if (Model.Live is not null && Model.RemoveAction is not null)
{
    <form id="remove-functions" method="post" action="@Model.RemoveAction" asp-antiforgery="true" data-confirm="@Model.RemoveConfirm"></form>
}
