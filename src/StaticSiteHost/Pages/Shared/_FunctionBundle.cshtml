@model StaticSiteHost.Pages.Shared.FunctionBundleView
@{
    var bundle = Model.Bundle;
    var canRemoveFiles = Model.RemoveFileAction is not null && bundle.Files.Count > 1;
}
<ul class="fn-files" aria-label="Live files">
    @foreach (var file in bundle.Files)
    {
        <li class="fn-file">
            @if (Model.EditorLink(file) is { } link)
            {
                <a class="mono" href="@link" title="Open in the editor">@file</a>
            }
            else
            {
                <span class="mono">@file</span>
            }
            @if (canRemoveFiles)
            {
                @* Removing a file redeploys the rest straight away: a bundle is compiled as a whole,
                   so there is no state in which a file is deleted but still running. *@
                <form method="post" action="@Model.RemoveFileAction" asp-antiforgery="true"
                      data-confirm="Remove @file? The other @(bundle.Files.Count - 1) file(s) are compiled and deployed without it. If anything in them uses it, nothing changes and you get the error."
                      data-busy="…">
                    <input type="hidden" name="fileName" value="@file" />
                    <button type="submit" class="fn-file-remove" aria-label="Remove @file" title="Remove @file and redeploy the rest">×</button>
                </form>
            }
        </li>
    }
</ul>
<p class="muted fn-meta">
    Uploaded @bundle.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") by @(bundle.UploadedBy ?? "unknown")
    @if (bundle.Warnings > 0)
    {
        <span>· @bundle.Warnings compiler warning(s)</span>
    }
    · <a href="@Model.SourceUrl">Download source</a>
</p>
<div class="table-wrap">
    <table>
        <thead>
            <tr><th>Method</th><th>Path</th><th>File</th></tr>
        </thead>
        <tbody>
            @foreach (var route in bundle.Routes)
            {
                var space = route.IndexOf(' ');
                var verb = space > 0 ? route[..space] : route;
                var template = space > 0 ? route[(space + 1)..] : "";
                // Only a GET with nothing to fill in is worth a link: anything else needs a body or a value.
                var linkable = Model.SiteUrl is not null && verb is "GET" or "ANY" && !template.Contains('{');
                bundle.RouteSources.TryGetValue(route, out var source);
                <tr>
                    <td class="mono nowrap">@verb</td>
                    <td class="mono">
                        @if (linkable)
                        {
                            <a href="@(Model.SiteUrl!.TrimEnd('/') + "/" + template.TrimStart('/'))" target="_blank" rel="noopener">@template</a>
                        }
                        else
                        {
                            @template
                        }
                    </td>
                    <td class="mono nowrap">
                        @if (source is null)
                        {
                            <span class="muted">—</span>
                        }
                        else if (Model.EditorLink(source.File, source.Line) is { } sourceLink)
                        {
                            <a href="@sourceLink" title="Open in the editor at line @source.Line">@source.File:@source.Line</a>
                        }
                        else
                        {
                            @($"{source.File}:{source.Line}")
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
