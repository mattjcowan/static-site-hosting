@model StaticSiteHost.Pages.Shared.FunctionBundleView
@using StaticSiteHost.Pages.Shared
@using StaticSiteHost.Services
@{
    var bundle = Model.Bundle;
    var status = Model.Status;
    var canRemoveFiles = Model.RemoveFileAction is not null && bundle.Files.Count > 1;
    var hasMiddleware = bundle.Middleware.Count > 0;
    var hasOthers = hasMiddleware || bundle.Services.Count > 0 || bundle.BackgroundServices.Count > 0 || bundle.Jobs.Count > 0 ||
                    bundle.Hooks.Count > 0;
    // The sentences that differ by what the functions run in the background, and by scope.
    var (loadedKey, notLoadedKey) = (bundle.BackgroundServices.Count > 0, bundle.Jobs.Count > 0) switch
    {
        (true, true) => ("functions.status.loadedBoth", "functions.status.notLoadedBoth"),
        (true, false) => ("functions.status.loadedBackground", "functions.status.notLoadedBackground"),
        (false, true) => ("functions.status.loadedJobs", "functions.status.notLoadedJobs"),
        _ => ("functions.status.loaded", "functions.status.notLoaded"),
    };

    // Where a handler or middleware method is written: a link into the editor when it may be edited.
    void SourceCell(string key)
    {
        bundle.RouteSources.TryGetValue(key, out var source);
        <td class="mono nowrap">
            @if (source is null)
            {
                <span class="muted">—</span>
            }
            else if (Model.EditorLink(source.File, source.Line) is { } sourceLink)
            {
                <a href="@sourceLink" title="@L.Text("functions.source.openAt", new { line = source.Line })">@source.File:@source.Line</a>
            }
            else
            {
                @($"{source.File}:{source.Line}")
            }
        </td>
    }
}
<ul class="fn-files" aria-label="@L["functions.files.label"]">
    @foreach (var file in bundle.Files)
    {
        <li class="fn-file">
            @if (Model.EditorLink(file) is { } link)
            {
                <a class="mono" href="@link" title="@L["functions.files.open"]">@file</a>
            }
            else
            {
                <span class="mono">@file</span>
            }
            @if (canRemoveFiles)
            {
                @* Removing a file redeploys the rest straight away: a bundle is compiled as a whole,
                   so there is no state in which a file is deleted but still running. *@
                <form method="post" action="@Model.RemoveFileAction" asp-antiforgery="true"
                      data-confirm="@L.Plural("functions.files.removeConfirm", bundle.Files.Count - 1, new { file })"
                      data-busy="…">
                    <input type="hidden" name="fileName" value="@file" />
                    <button type="submit" class="fn-file-remove" aria-label="@L.Text("functions.files.remove", new { file })" title="@L.Text("functions.files.removeTitle", new { file })">×</button>
                </form>
            }
        </li>
    }
</ul>
<p class="muted fn-meta">
    @L.Text("functions.meta.uploaded", new { time = bundle.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm"), name = bundle.UploadedBy ?? L["functions.meta.unknownUser"].Value })
    @if (bundle.AbstractionsVersion is { } abstractions)
    {
        <span>· @L.Html("functions.meta.compiledAgainst", new { version = abstractions })</span>
    }
    @if (bundle.Warnings > 0)
    {
        <span>· @L.Plural("functions.meta.warnings", bundle.Warnings)</span>
    }
    · <a href="@Model.SourceUrl">@L["functions.meta.downloadSource"]</a>
</p>
@if (status is not null && !Model.NeedsNewerServer)
{
    @* Where the live set stands. A failure has its own alert; with middleware, FunctionHost fails
       closed, so say what visitors are getting meanwhile. *@
    switch (status.State)
    {
        case FunctionLoadState.Loaded:
            <p class="muted fn-status">@L.Text(loadedKey, new { time = status.LoadedUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") })</p>
            break;
        case FunctionLoadState.Loading:
            <p class="muted fn-status">@L["functions.status.loading"]</p>
            break;
        case FunctionLoadState.NotLoaded:
            <p class="muted fn-status">@L[notLoadedKey]</p>
            break;
        case FunctionLoadState.Failed:
            <div class="alert alert-error">
                @L.Html("functions.status.failed", new { message = status.Message })
                @if (hasMiddleware)
                {
                    @L.Html(Model.IsGlobal ? "functions.status.failedClosedGlobal" : "functions.status.failedClosedSite")
                }
                else
                {
                    @L["functions.status.failedFix"]
                }
                @L["functions.status.failedLog"]
            </div>
            break;
    }
}
@if (Model.NeedsNewerServer)
{
    @* A server rolled back past the version the functions were built on. They could call members
       this server's copy lacks, so FunctionHost does not load them at all. *@
    <div class="alert alert-warning">
        @L.Html("functions.newer.message", new { version = bundle.AbstractionsVersion, serverVersion = Model.HostAbstractionsVersion })
        @L["functions.newer.fix"]
        @if (hasMiddleware)
        {
            @L.Html(Model.IsGlobal ? "functions.newer.closedGlobal" : "functions.newer.closedSite")
        }
    </div>
}
@if (hasMiddleware)
{
    <h3 class="fn-subhead">@L["functions.middleware.title"]</h3>
    <p class="hint fn-subhint">@L["functions.middleware.hint"]</p>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>@L["functions.middleware.order"]</th><th>@L["functions.column.method"]</th><th>@L["functions.column.file"]</th></tr>
            </thead>
            <tbody>
                @foreach (var middleware in bundle.Middleware)
                {
                    var space = middleware.IndexOf(' ');
                    <tr>
                        <td class="mono nowrap">@(space > 0 ? middleware[..space] : "")</td>
                        <td class="mono">@(space > 0 ? middleware[(space + 1)..] : middleware)</td>
                        @{ SourceCell(middleware); }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@if (bundle.Routes.Count > 0)
{
    if (hasOthers)
    {
        <h3 class="fn-subhead">@L["functions.routes.title"]</h3>
    }
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>@L["functions.routes.method"]</th><th>@L["functions.routes.path"]</th><th>@L["functions.column.file"]</th></tr>
            </thead>
            <tbody>
                @foreach (var route in bundle.Routes)
                {
                    var space = route.IndexOf(' ');
                    var verb = space > 0 ? route[..space] : route;
                    var template = space > 0 ? route[(space + 1)..] : "";
                    // Only a GET with nothing to fill in is worth a link: anything else needs a body or a value.
                    var linkable = Model.SiteUrl is not null && verb is "GET" or "ANY" && !template.Contains('{');
                    <tr>
                        <td class="mono nowrap">@verb</td>
                        <td class="mono">
                            @if (linkable)
                            {
                                <a href="@(Model.SiteUrl!.TrimEnd('/') + "/" + template.TrimStart('/'))" target="_blank" rel="noopener">@template</a>
                            }
                            else
                            {
                                @template
                            }
                        </td>
                        @{ SourceCell(route); }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@if (bundle.Services.Count > 0)
{
    <h3 class="fn-subhead">@L["functions.services.title"]</h3>
    <p class="hint fn-subhint">@L["functions.services.hint"]</p>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>@L["functions.column.method"]</th><th>@L["functions.column.file"]</th></tr>
            </thead>
            <tbody>
                @foreach (var method in bundle.Services)
                {
                    <tr>
                        <td class="mono">@method</td>
                        @{ SourceCell(method); }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@if (bundle.BackgroundServices.Count > 0)
{
    <h3 class="fn-subhead">@L["functions.background.title"]</h3>
    <p class="hint fn-subhint">@L["functions.background.hint"]</p>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>@L["functions.column.method"]</th>
                    @if (status is not null)
                    {
                        <th>@L["functions.background.state"]</th><th>@L["functions.background.restarts"]</th><th>@L["functions.column.lastError"]</th>
                    }
                    <th>@L["functions.column.file"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var method in bundle.BackgroundServices)
                {
                    var service = Model.BackgroundStatus(method);
                    <tr>
                        <td class="mono">@method</td>
                        @if (status is not null)
                        {
                            <td class="nowrap">
                                @if (service is null)
                                {
                                    <span class="muted">—</span>
                                }
                                else
                                {
                                    var stateKey = service.State switch
                                    {
                                        FunctionBackgroundState.Running => "functions.background.running",
                                        FunctionBackgroundState.Restarting => "functions.background.restarting",
                                        FunctionBackgroundState.Stopped => "functions.background.stopped",
                                        _ => "functions.background.finished",
                                    };
                                    <span class="badge @(service.State switch { FunctionBackgroundState.Running => "badge-ok", FunctionBackgroundState.Restarting => "badge-warn", _ => "" })"
                                          title="@(service.StartedUtc is { } started ? L.Text("functions.background.startedTitle", new { time = FunctionBundleView.When(started) }) : "")">@L[stateKey]</span>
                                }
                            </td>
                            <td class="nowrap">@(service?.Restarts.ToString() ?? "—")</td>
                            <td class="fn-error">@(service?.LastError ?? "")</td>
                        }
                        @{ SourceCell(method); }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@if (bundle.Jobs.Count > 0)
{
    <h3 class="fn-subhead">@L["functions.jobs.title"]</h3>
    <p class="hint fn-subhint">@L["functions.jobs.hint"]</p>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>@L["functions.jobs.schedule"]</th><th>@L["functions.column.method"]</th><th>@L["functions.column.file"]</th>
                    @if (status is not null)
                    {
                        <th>@L["functions.jobs.lastRun"]</th><th>@L["functions.jobs.nextRun"]</th><th>@L["functions.jobs.runs"]</th><th>@L["functions.column.lastError"]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var display in bundle.Jobs)
                {
                    var (schedule, method, onStart) = FunctionBundleView.SplitJob(display);
                    var job = Model.JobStatus(display);
                    <tr>
                        <td class="mono nowrap">
                            @schedule
                            @if (onStart)
                            {
                                <span class="muted" title="@L["functions.jobs.onStartTitle"]">@L["functions.jobs.onStart"]</span>
                            }
                        </td>
                        <td class="mono">@method</td>
                        @{ SourceCell(display); }
                        @if (status is not null)
                        {
                            <td class="nowrap">
                                @if (job is { IsRunning: true })
                                {
                                    <span class="badge badge-ok">@L["functions.jobs.running"]</span> <span class="muted">@L.Text("functions.jobs.since", new { time = FunctionBundleView.When(job.LastStartedUtc) })</span>
                                }
                                else if (job?.LastStartedUtc is { } started)
                                {
                                    @FunctionBundleView.When(started) <span class="muted">· @FunctionBundleView.Took(job.LastDuration)</span>
                                }
                                else
                                {
                                    <span class="muted">@L["functions.jobs.notYet"]</span>
                                }
                            </td>
                            <td class="nowrap">@FunctionBundleView.When(job?.NextRunUtc)</td>
                            <td class="nowrap">
                                @(job?.Runs.ToString() ?? "—") / @(job?.Failures.ToString() ?? "—")
                                @if (job is { Skipped: > 0 })
                                {
                                    <span class="muted" title="@L["functions.jobs.skippedTitle"]">· @L.Plural("functions.jobs.skipped", job.Skipped)</span>
                                }
                            </td>
                            <td class="fn-error" title="@(job?.LastErrorUtc is { } failed ? L.Text("functions.jobs.lastErrorTitle", new { time = FunctionBundleView.When(failed) }) : "")">@(job?.LastError ?? "")</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@if (bundle.Hooks.Count > 0)
{
    <h3 class="fn-subhead">@L["functions.hooks.title"]</h3>
    <p class="hint fn-subhint">@L[Model.IsGlobal ? "functions.hooks.hintGlobal" : "functions.hooks.hintSite"]</p>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>@L["functions.hooks.hook"]</th><th>@L["functions.column.method"]</th><th>@L["functions.hooks.decides"]</th><th>@L["functions.column.file"]</th></tr>
            </thead>
            <tbody>
                @foreach (var hook in bundle.Hooks)
                {
                    var space = hook.IndexOf(' ');
                    var kind = space > 0 ? hook[..space] : hook;
                    <tr>
                        <td class="mono nowrap">[@kind]</td>
                        <td class="mono">@(space > 0 ? hook[(space + 1)..] : "")</td>
                        <td>
                            @(kind switch
                            {
                                "RealtimeConnect" => L.Html("functions.hooks.realtimeConnect"),
                                "RealtimeJoin" => L.Html("functions.hooks.realtimeJoin"),
                                "AiAccess" => L.Html("functions.hooks.aiAccess"),
                                _ => Microsoft.AspNetCore.Html.HtmlString.Empty,
                            })
                        </td>
                        @{ SourceCell(hook); }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
