@model StaticSiteHost.Pages.Shared.FunctionErrorsView
@{
    // Errors only: warnings and the host's "info" notes would bury the line that stopped the deploy.
    var errors = Model.Diagnostics.Where(d => d.Severity == "error").ToList();
}
@if (Model.Error is not null)
{
    <div class="alert alert-error">
        <strong>@L["functions.errors.title"]</strong>
        @if (errors.Count == 0)
        {
            <p>@Model.Error</p>
        }
        else
        {
            <ul class="mono">
                @foreach (var error in errors.Take(20))
                {
                    <li>@(error.File.Length > 0 ? error.File + (error.Line > 0 ? $":{error.Line}:{error.Column}" : "") : error.Line > 0 ? L.Text("functions.errors.line", new { line = error.Line, column = error.Column }) : "") @error.Code @error.Message</li>
                }
            </ul>
            @if (errors.Count > 20)
            {
                <p>@L.Plural("functions.errors.more", errors.Count - 20)</p>
            }
        }
    </div>
}
