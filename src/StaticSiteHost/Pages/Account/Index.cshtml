@page
@model StaticSiteHost.Pages.Account.IndexModel
@{
    ViewData["Title"] = L["account.pageTitle"].Value;
}

<div class="page-head">
    <h1>@L["account.title"]</h1>
    <p>@L["account.intro"]</p>
</div>

@if (!string.IsNullOrEmpty(Model.NewApiKey))
{
    <div class="secret-box">
        <h2>@L["account.newKey.title"]</h2>
        <p class="hint">@L["account.newKey.hint"]</p>
        <div class="copyfield">
            <input type="text" id="new-api-key" value="@Model.NewApiKey" readonly onclick="this.select()" />
            <button type="button" class="btn" data-copy="#new-api-key">@L["common.copy"]</button>
        </div>
    </div>
}

<div class="grid-2">
    <div class="card">
        <h2>@L["account.profile.title"]</h2>
        <p class="hint">
            <strong>@Model.Account.Username</strong>
            <span class="badge @(Model.Account.IsAdministrator ? "badge-admin" : null)">@L[Model.Account.IsAdministrator ? "account.profile.administrator" : "account.profile.member"]</span>
            <br />
            @(Model.Account.LastLoginUtc is { } seen
                ? L.Text("account.profile.createdAndSignedIn", new { date = Model.Account.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd"), time = seen.ToLocalTime().ToString("yyyy-MM-dd HH:mm") })
                : L.Text("account.profile.created", new { date = Model.Account.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd") }))
        </p>

        <form method="post" asp-page-handler="Profile">
            <div class="field">
                <label for="displayName">@L["account.profile.displayName"]</label>
                <input type="text" id="displayName" name="displayName" value="@Model.Account.DisplayName" maxlength="128" required />
            </div>
            <button type="submit">@L["common.save"]</button>
        </form>
    </div>

    <div class="card">
        <h2>@L["account.password.title"]</h2>
        <p class="hint">
            @(Model.Account.PasswordChangedUtc is { } changed
                ? L.Text("account.password.lastChanged", new { time = changed.ToLocalTime().ToString("yyyy-MM-dd HH:mm") })
                : L.Text("account.password.neverChanged"))
        </p>
        <a class="btn" asp-page="Password">@L["account.password.change"]</a>
    </div>
</div>

<div class="card">
    <h2>@L["account.keys.title"]</h2>
    <p class="hint">@L.Html("account.keys.hint")</p>

    <form method="post" asp-page-handler="CreateKey" class="row" style="margin-bottom:1.25rem">
        <div class="field">
            <label for="name">@L["account.keys.name"]</label>
            <input type="text" id="name" name="name" placeholder="@L["account.keys.namePlaceholder"]" maxlength="64" required />
        </div>
        <div class="field" style="flex:0 1 160px">
            <label for="expiresInDays">@L["account.keys.expiresIn"]</label>
            <input type="number" id="expiresInDays" name="expiresInDays" min="1" max="3650" placeholder="@L["account.keys.expiresPlaceholder"]" />
        </div>
        <button type="submit" class="btn-primary">@L["account.keys.create"]</button>
    </form>

    @if (Model.ApiKeys.Count == 0)
    {
        <p class="empty">@L["account.keys.empty"]</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>@L["account.keys.column.name"]</th>
                        <th>@L["account.keys.column.key"]</th>
                        <th>@L["account.keys.column.created"]</th>
                        <th>@L["account.keys.column.lastUsed"]</th>
                        <th>@L["account.keys.column.status"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var key in Model.ApiKeys)
                    {
                        <tr>
                            <td>@key.Name</td>
                            <td class="mono nowrap">@key.Display</td>
                            <td class="nowrap muted">@key.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td class="nowrap muted">@(key.LastUsedUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? L["account.keys.neverUsed"].Value)</td>
                            <td>
                                @if (key.Revoked)
                                {
                                    <span class="badge badge-off">@L["account.keys.status.revoked"]</span>
                                }
                                else if (key.IsExpired)
                                {
                                    <span class="badge badge-warn">@L["account.keys.status.expired"]</span>
                                }
                                else if (key.ExpiresUtc is { } expires)
                                {
                                    <span class="badge">@L.Text("account.keys.status.until", new { date = expires.ToLocalTime().ToString("yyyy-MM-dd") })</span>
                                }
                                else
                                {
                                    <span class="badge badge-ok">@L["account.keys.status.active"]</span>
                                }
                            </td>
                            <td class="actions">
                                @if (!key.Revoked)
                                {
                                    <form method="post" asp-page-handler="RevokeKey" data-confirm="@L.Text("account.keys.revokeConfirm", new { name = key.Name })">
                                        <input type="hidden" name="keyId" value="@key.Id" />
                                        <button type="submit" class="btn-link danger">@L["account.keys.revoke"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
