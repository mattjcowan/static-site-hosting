@page
@model StaticSiteHost.Pages.Account.PasswordModel
@{
    ViewData["Title"] = "Change password";
}

<div class="narrow">
    <div class="page-head">
        <h1>Change password</h1>
        @if (Model.Required)
        {
            <p>Your password was assigned for you. Choose your own before continuing.</p>
        }
    </div>

    <div class="card">
        <form method="post">
            <input type="hidden" asp-for="Required" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error" role="alert">
                    @foreach (var message in ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Distinct())
                    {
                        <div>@message</div>
                    }
                </div>
            }

            <div class="field">
                <label asp-for="Input.CurrentPassword">Current password</label>
                <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" autofocus required />
            </div>

            <div class="field">
                <label asp-for="Input.NewPassword">New password</label>
                <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" required />
            </div>

            <div class="field">
                <label asp-for="Input.ConfirmPassword">Confirm new password</label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
            </div>

            <button type="submit" class="btn-primary" style="width:100%">Change password</button>
        </form>
    </div>
</div>
