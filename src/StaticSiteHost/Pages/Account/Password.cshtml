@page
@model StaticSiteHost.Pages.Account.PasswordModel
@{
    ViewData["Title"] = L["account.changePassword.title"].Value;
}

<div class="narrow">
    <div class="page-head">
        <h1>@L["account.changePassword.title"]</h1>
        @if (Model.Required)
        {
            <p>@L["account.changePassword.required"]</p>
        }
    </div>

    <div class="card">
        <form method="post">
            <input type="hidden" asp-for="Required" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error" role="alert">
                    @foreach (var message in ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Distinct())
                    {
                        <div>@message</div>
                    }
                </div>
            }

            <div class="field">
                <label asp-for="Input.CurrentPassword">@L["account.changePassword.current"]</label>
                <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" autofocus required />
            </div>

            <div class="field">
                <label asp-for="Input.NewPassword">@L["account.changePassword.new"]</label>
                <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" required />
            </div>

            <div class="field">
                <label asp-for="Input.ConfirmPassword">@L["account.changePassword.confirm"]</label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
            </div>

            <button type="submit" class="btn-primary" style="width:100%">@L["account.changePassword.submit"]</button>
        </form>
    </div>
</div>
